n  login_url:     { type: string, default: \"https://login.salesforce.com\" }\n\npipeline:\n  sources:\n    default:\n      type: rest\n      config:\n        method: GET\n        base_url: \"${param.instance_url}\"\n        path: \"/\"\n        auth:\n          type: token_endpoint\n          config:\n            url: \"${param.login_url}/services/oauth2/token\"\n            method: POST\n            encoding: form\n            token_path: \"$.access_token\"\n            expiry_ratio: 0.9\n            body:\n              grant_type: \"refresh_token\"\n              client_id: \"${param.client_id}\"\n              client_secret: \"${param.client_secret}\"\n              refresh_token: \"${param.refresh_token}\"\n        async_job:\n          submit:\n            method: POST\n            url: \"/services/data/v60.0/jobs/query\"\n            json: { operation: \"queryAll\", query: \"SELECT Id FROM Account\" }\n          job_id: \"$.id\"\n          poll:\n            url: \"/services/data/v60.0/jobs/query/${job_id}\"\n            interval_secs: 2\n            timeout_secs: 1800\n          status: { path: \"$.state\", success: [JobComplete], failure: [Failed, Aborted] }\n          fetch:\n            method: GET\n            url: \"/services/data/v60.0/jobs/query/${job_id}/results\"\n            locator_header: \"Sforce-Locator\"\n            locator_param: \"locator\"\n            query: { maxRecords: \"50000\" }\n        response_format: csv\n        pagination: { type: None }\n        query_params: {}\n        max_retries: 3\n        retry_backoff: 1\n        tolerated_http_errors: []\n        replication_method: { type: FullTable }\n        primary_keys: [Id]\n        # #647 run-time fan-out: discover these objects' fields live and generate\n        # one matrix row per object, routed to the `bigquery` sink template.\n        salesforce:\n          fan_out: true\n          objects: \"${param.objects}\"\n          sink_ref: bigquery\n\n  sinks:\n    bigquery:\n      type: bigquery\n      config:\n        project_id: \"drivetrain-preprod\"\n        dataset_id: \"tenant2425_faucet_stream\"\n        table_id: \"sf647_generic_placeholder\"   # overridden per-object at fan-out\n        write_mode: overwrite\n        media_load: true\n        auth: { type: service_account_key, config: { json: \"${file:/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream/faucet-local-demo/drivetrain/bq-sa-key-preprod.json}\" } }\n\nexecution:\n  max_concurrent: 5\n  on_error: continue\n","structuredPatch":[{"oldStart":61,"oldLines":6,"newStart":61,"newLines":8,"lines":["         tolerated_http_errors: []","         replication_method: { type: FullTable }","         primary_keys: [Id]","+        partitions: []","+        schema_sample_size: 100","         # #647 run-time fan-out: discover these objects' fields live and generate","         # one matrix row per object, routed to the `bigquery` sink template.","         salesforce:"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"20ba790a-afcd-455f-a200-4928a8f135f8","session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.231","gitBranch":"feat/native-byte-passthrough-633","slug":"linear-noodling-leaf"}
