 Kafka::default().start().await.expect(\"kafka start\");\n    let port = container.get_host_port_ipv4(KAFKA_PORT).await.expect(\"port\");\n    (container, format!(\"127.0.0.1:{port}\"))\n}\n\nfn sink_config(brokers: &str, topic: &str) -> KafkaSinkConfig {\n    KafkaSinkConfig {\n        brokers: brokers.into(),\n        topic: KafkaSinkTopic::Fixed { name: topic.into() },\n        auth: KafkaAuth::None,\n        value_format: KafkaValueFormat::Json,\n        key_format: None,\n        value_schema: None,\n        key_schema: None,\n        key_path: None,\n        partition_path: None,\n        headers_path: None,\n        on_key_error: OnKeyError::Fail,\n        compression: CompressionType::None,\n        acks: Acks::All,\n        idempotent: true,\n        linger: StdDuration::from_millis(5),\n        batch_size: DEFAULT_BATCH_SIZE,\n        message_timeout: StdDuration::from_secs(15),\n        max_in_flight: 50,\n        queue_full_backoff: StdDuration::from_millis(100),\n        queue_full_max_retries: 3,\n        transactional_id_prefix: None,\n        commit_token_topic: \"__faucet_commit_token\".into(),\n        commit_token_topic_partitions: 1,\n        commit_token_topic_replication: 1,\n        extra_client_config: BTreeMap::new(),\n    }\n}\"\"\",1)\nopen(p,\"w\").write(s)\nprint(\"ok\")\nPY\nTOOL=~/.rustup/toolchains/1.96.0-aarch64-apple-darwin/bin\nexport PATH=$TOOL:$PATH RUSTC=$TOOL/rustc CARGO_INCREMENTAL=0\ncargo build -p faucet-sink-kafka --all-features --tests 2>&1 | grep -E \"^error\" -A 7 | head -25; echo BUILD_DONE","description":"Align the test config and build","timeout":900000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":738,"cache_read_input_tokens":768459,"output_tokens":1604,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cach