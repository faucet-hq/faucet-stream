{"parentUuid":"3737b7c0-12f6-491b-b57b-c071cebb706f","isSidechain":false,"promptId":"1e50a2b8-f79b-4f2b-a79b-e532971b731e","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DVovna3WtXgyJSfG1LR97m","type":"tool_result","content":"diff --git a/crates/core/src/lib.rs b/crates/core/src/lib.rs\nindex 4b92828b..6c8d988f 100644\n--- a/crates/core/src/lib.rs\n+++ b/crates/core/src/lib.rs\n@@ -176,13 +176,13 @@ pub use transforming_source::TransformingSource;\n #[cfg(feature = \"transform-tree-flatten\")]\n pub use tree::{AncestorsSpec, ColumnsSpec, CompiledTreeFlatten, TreeFlattenSpec};\n pub use util::redact_uri_credentials;\n-pub use verify::{IntegrityCheck, LengthCheck, VerifyingReader};\n+pub use verify::{IntegrityCheck, LengthCheck, ObjectVerifySpec, VerifyingReader};\n pub use window::{\n     WINDOW_PLACEHOLDER, Window, WindowBind, WindowSpec, enumerate_windows, parse_step,\n };\n pub use write_mode::{\n     DeleteMarker, KeyTuple, OverwriteScope, WriteMode, WritePlan, WriteSpec, key_to_doc_id,\n-    key_to_filter, plan_writes,\n+    key_to_filter, plan_writes, sql_literal,\n };\n #[cfg(feature = \"transform-zip-columns\")]\n pub use zip_columns::{CompiledZipColumns, ZipColumnsSpec};\ndiff --git a/crates/core/src/pipeline.rs b/crates/core/src/pipeline.rs\nindex b4f41d24..22daa93f 100644\n--- a/crates/core/src/pipeline.rs\n+++ b/crates/core/src/pipeline.rs\n@@ -5285,6 +5285,11 @@ mod tests {\n         let sink = TokenCapableButPlainInsertSink {\n             attempts: attempts.clone(),\n         };\n+        // State the premise the regression turned on: this sink DOES advertise\n+        // the commit-token protocol, and its plain write is still NOT\n+        // replay-safe. Gating on the former is what caused the duplication.\n+        assert!(sink.supports_idempotent_writes());\n+        assert!(!sink.write_batch_is_replay_safe());\n         let pages = futures::stream::iter(vec![Ok(StreamPage {\n             records: vec![json!({\"a\": 1})],\n             bookmark: None,\ndiff --git a/crates/core/src/stage.rs b/crates/core/src/stage.rs\nindex e37eee8e..05417a7b 100644\n--- a/crates/core/src/stage.rs\n+++ b/crates/core/src/stage.rs\n@@ -650,6 +650,15 @@ impl CompiledExplode {\n \n // ── CDC unwrap spec ──\n \n+/// Default field `cdc_unwrap` stamps the normalized op marker onto.\n+///\n+/// Reserved, and the value a `WriteSpec::delete_marker` must be pointed at for\n+/// a CDC → upsert mirror to delete rather than insert — so it is defined here\n+/// once and consumed by every surface that needs to agree on it (the serde\n+/// default below, the CLI decoder, the conformance battery). Not feature-gated:\n+/// consumers that never compile the transform still need the name (#654 M17).\n+pub const CDC_DEFAULT_MARKER_FIELD: &str = \"__op\";\n+\n /// Spec for [`TransformStage::CdcUnwrap`]. Normalizes a CDC change-event\n /// envelope (`{op, before, after, …}`) into a flat row plus a marker field,\n /// so a downstream upsert sink never needs to understand CDC. A 1→0|1 stage:\n@@ -674,7 +683,10 @@ pub struct CdcUnwrapSpec {\n     /// Field stamped on every emitted row. Default `\"__op\"`.\n     #[serde(default = \"cdc_default_marker_field\")]\n     pub marker_field: String,\n-    /// `op` values that mean delete. Default covers all three CDC vocabularies.\n+    /// `op` values that mean delete. Default `[\"d\", \"delete\"]` — the two\n+    /// spellings the built-in CDC sources emit (`postgres-cdc` uses the long\n+    /// form, `mysql-cdc` / `mongodb-cdc` / `mssql-cdc` the short one). Override\n+    /// for a feed that spells deletes differently.\n     #[serde(default = \"cdc_default_delete_ops\")]\n     pub delete_ops: Vec<String>,\n     /// `op` values dropped entirely (1→0). Default `[\"ddl\", \"truncate\"]`.\n@@ -700,7 +712,7 @@ fn cdc_default_key_field() -> String {\n }\n #[cfg(feature = \"transform-cdc-unwrap\")]\n fn cdc_default_marker_field() -> String {\n-    \"__op\".into()\n+    CDC_DEFAULT_MARKER_FIELD.into()\n }\n #[cfg(feature = \"transform-cdc-unwrap\")]\n fn cdc_default_delete_ops() -> Vec<String> {\n@@ -1958,6 +1970,36 @@ mod tests {\n \n     // ── CdcUnwrap ──\n \n+    #[test]\n+    fn cdc_default_marker_field_is_pinned() {\n+        // A sink's `delete_marker.field` is configured against this literal, so\n+        // moving it would make every existing CDC → upsert config stamp a\n+        // marker the sink no longer looks for.\n+        assert_eq!(CDC_DEFAULT_MARKER_FIELD, \"__op\");\n+    }\n+\n+    #[cfg(feature = \"transform-cdc-unwrap\")]\n+    #[test]\n+    fn cdc_unwrap_spec_default_marker_uses_the_constant() {\n+        assert_eq!(\n+            CdcUnwrapSpec::default().marker_field,\n+            CDC_DEFAULT_MARKER_FIELD\n+        );\n+        // An omitted `marker_field` must land on the same value as the `Default`\n+        // impl — the serde path is the one real configs take.\n+        let decoded: CdcUnwrapSpec = serde_json::from_value(json!({})).unwrap();\n+        assert_eq!(decoded.marker_field, CDC_DEFAULT_MARKER_FIELD);\n+    }\n+\n+    /// Pins the documented `delete_ops` default: the short code emitted by\n+    /// `mysql-cdc` / `mongodb-cdc` / `mssql-cdc` and the long one emitted by\n+    /// `postgres-cdc`, and nothing else.\n+    #[cfg(feature = \"transform-cdc-unwrap\")]\n+    #[test]\n+    fn cdc_unwrap_default_delete_ops_match_the_doc() {\n+        assert_eq!(CdcUnwrapSpec::default().delete_ops, vec![\"d\", \"delete\"]);\n+    }\n+\n     #[cfg(feature = \"transform-cdc-unwrap\")]\n     fn cdc_unwrap_default() -> TransformStage {\n         TransformStage::CdcUnwrap(CdcUnwrapSpec::default())\ndiff --git a/crates/core/src/verify.rs b/crates/core/src/verify.rs\nindex 8e6db885..682a4683 100644\n--- a/crates/core/src/verify.rs\n+++ b/crates/core/src/verify.rs\n@@ -16,12 +16,79 @@\n //! The built-in [`LengthCheck`] guards against truncation. Connector crates\n //! implement [`IntegrityCheck`] over their own hash libraries for opt-in\n //! checksum verification.\n+//!\n+//! [`ObjectVerifySpec`] is the matching config block — the single `{\n+//! verify_length, verify_checksum }` shape every object-store source flattens\n+//! into its own config, so the two switches are named and documented once.\n \n+use schemars::JsonSchema;\n+use serde::{Deserialize, Serialize};\n use std::io;\n use std::pin::Pin;\n use std::task::{Context, Poll};\n use tokio::io::{AsyncRead, ReadBuf};\n \n+fn default_true() -> bool {\n+    true\n+}\n+\n+/// The read-integrity knobs every object-store source shares (#161).\n+///\n+/// One concept, one shape: the S3, GCS, and Azure Blob sources all\n+/// `#[serde(flatten)]` this block, so the YAML keys stay `verify_length` and\n+/// `verify_checksum` at the connector-config top level and every store\n+/// documents the same two switches identically.\n+///\n+/// Because it is flattened, a config embedding it cannot also carry\n+/// `#[serde(deny_unknown_fields)]` — serde rejects that combination.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]\n+pub struct ObjectVerifySpec {\n+    /// Verify each object's byte length against the length the store advertises\n+    /// for it — `Content-Length` on S3, object `size` on GCS and Azure Blob —\n+    /// failing the read with [`FaucetError::Source`](crate::FaucetError::Source)\n+    /// on a short (truncated) or over-long transfer.\n+    ///\n+    /// The check is cheap (a byte counter over a body that is read anyway) and\n+    /// defaults to `true`. It is skipped for an individual object, with a debug\n+    /// log, in two cases: the store advertises no usable length, or the object\n+    /// is served with a non-empty `Content-Encoding` (a store may\n+    /// decompressively transcode it on read, so the received byte count would\n+    /// not match the stored length). Disable it only for a store that does not\n+    /// return a reliable length.\n+    #[serde(rename = \"verify_length\", default = \"default_true\")]\n+    pub length: bool,\n+    /// Verify each object's body against the checksum the store advertises for\n+    /// it. On S3 that is an `x-amz-checksum-{sha256,crc64nvme,crc32c,crc32}`\n+    /// header when present (strongest first), or the ETag as MD5 for a\n+    /// non-multipart upload; on GCS the reported CRC-32C (preferred) or MD5.\n+    ///\n+    /// Stronger than the length check but it costs a hash over the full body,\n+    /// so it defaults to `false`. On S3, enabling it sets\n+    /// `ChecksumMode::Enabled` on each `GetObject` so the store returns its\n+    /// stored checksum. Verification is skipped for an individual object, with\n+    /// a log, when the store advertises no checksum this build can compute or\n+    /// when the object is served with a non-empty `Content-Encoding` (the\n+    /// stored checksum covers the stored bytes, which transcoding would not\n+    /// return); the length check still applies.\n+    ///\n+    /// Not every store exposes a body checksum through its read API. The Azure\n+    /// Blob source has no access to one, so it rejects `verify_checksum: true`\n+    /// at config-load time rather than accepting a switch it cannot honour.\n+    #[serde(rename = \"verify_checksum\", default)]\n+    pub checksum: bool,\n+}\n+\n+impl Default for ObjectVerifySpec {\n+    /// Length verification on, checksum verification off — the cheap check is\n+    /// always worth it; the full-body hash is opt-in.\n+    fn default() -> Self {\n+        Self {\n+            length: true,\n+            checksum: false,\n+        }\n+    }\n+}\n+\n /// A check fed the raw bytes of an object body as they stream past, and asked\n /// to validate once the underlying reader reaches EOF.\n pub trait IntegrityCheck: Send {\n@@ -135,6 +202,85 @@ impl<R: AsyncRead + Unpin> AsyncRead for VerifyingReader<R> {\n     }\n }\n \n+#[cfg(test)]\n+mod spec_tests {\n+    use super::ObjectVerifySpec;\n+    use serde::{Deserialize, Serialize};\n+\n+    /// Stand-in for a connector config that flattens the spec — proves the\n+    /// wire keys are `verify_length` / `verify_checksum` at the *parent* level.\n+    #[derive(Debug, Serialize, Deserialize, PartialEq, Eq)]\n+    struct Host {\n+        bucket: String,\n+        #[serde(flatten)]\n+        verify: ObjectVerifySpec,\n+    }\n+\n+    #[test]\n+    fn default_is_length_on_checksum_off() {\n+        let s = ObjectVerifySpec::default();\n+        assert!(s.length, \"the cheap length check defaults on\");\n+        assert!(!s.checksum, \"the full-body hash defaults off\");\n+    }\n+\n+    #[test]\n+    fn flattened_keys_are_the_legacy_names() {\n+        let json = serde_json::to_value(Host {\n+            bucket: \"b\".into(),\n+            verify: ObjectVerifySpec::default(),\n+        })\n+        .unwrap();\n+        assert_eq!(json[\"verify_length\"], serde_json::json!(true));\n+        assert_eq!(json[\"verify_checksum\"], serde_json::json!(false));\n+        assert!(\n+            json.get(\"verify\").is_none() && json.get(\"length\").is_none(),\n+            \"flatten must not introduce a nested block: {json}\"\n+        );\n+    }\n+\n+    #[test]\n+    fn flattened_keys_deserialize_at_the_parent_level() {\n+        let host: Host =\n+            serde_json::from_str(r#\"{\"bucket\":\"b\",\"verify_length\":false,\"verify_checksum\":true}\"#)\n+                .unwrap();\n+        assert!(!host.verify.length);\n+        assert!(host.verify.checksum);\n+    }\n+\n+    #[test]\n+    fn absent_keys_fall_back_to_defaults() {\n+        // A config written before these fields existed must still parse.\n+        let host: Host = serde_json::from_str(r#\"{\"bucket\":\"b\"}\"#).unwrap();\n+        assert!(host.verify.length);\n+        assert!(!host.verify.checksum);\n+    }\n+\n+    #[test]\n+    fn round_trips_through_serde() {\n+        let original = Host {\n+            bucket: \"b\".into(),\n+            verify: ObjectVerifySpec {\n+                length: false,\n+                checksum: true,\n+            },\n+        };\n+        let text = serde_json::to_string(&original).unwrap();\n+        let back: Host = serde_json::from_str(&text).unwrap();\n+        assert_eq!(original, back);\n+    }\n+\n+    #[test]\n+    fn schema_exposes_the_legacy_key_names() {\n+        let schema = serde_json::to_value(schemars::schema_for!(ObjectVerifySpec)).unwrap();\n+        let props = &schema[\"properties\"];\n+        assert!(props.get(\"verify_length\").is_some(), \"{schema}\");\n+        assert!(props.get(\"verify_checksum\").is_some(), \"{schema}\");\n+        // Descriptions become `faucet schema` output — both must be present.\n+        assert!(props[\"verify_length\"][\"description\"].is_string());\n+        assert!(props[\"verify_checksum\"][\"description\"].is_string());\n+    }\n+}\n+\n #[cfg(test)]\n mod tests {\n     use super::*;\ndiff --git a/crates/core/src/write_mode.rs b/crates/core/src/write_mode.rs\nindex e607ef5c..d4af324d 100644\n--- a/crates/core/src/write_mode.rs\n+++ b/crates/core/src/write_mode.rs\n@@ -117,8 +117,25 @@ impl OverwriteScope {\n     }\n }\n \n-/// Render a JSON scalar as a SQL literal (strings single-quoted + escaped).\n-fn sql_literal(v: &Value) -> String {\n+/// Render a JSON scalar as an **ANSI-standard** SQL literal: strings are\n+/// single-quoted with embedded quotes doubled (`''`), numbers and booleans pass\n+/// through in their canonical form, and anything else becomes `NULL`.\n+///\n+/// This is the house escaper for every dialect that follows the ANSI rule —\n+/// Postgres (with `standard_conforming_strings`, the default since 9.1), BigQuery\n+/// string literals built by the overwrite/cleanup planners, MySQL under\n+/// `NO_BACKSLASH_ESCAPES`, SQL Server, and SQLite. **Public so connectors escape\n+/// through one audited implementation instead of hand-rolling a third\n+/// convention** (#654 M14): the copies that existed before it was exported each\n+/// invented their own rules, so a fix to one reached none of the others.\n+///\n+/// A dialect whose string literals treat some *other* character as a\n+/// meta-character cannot use this function — doubling quotes alone does not\n+/// neutralise a trailing escape character. Such a dialect must keep its own\n+/// escaper, and that escaper's doc comment must state which extra characters it\n+/// escapes and why (see `faucet_common_clickhouse::sql_literal`, where a\n+/// backslash is a literal meta-character).\n+pub fn sql_literal(v: &Value) -> String {\n     match v {\n         Value::String(s) => format!(\"'{}'\", s.replace('\\'', \"''\")),\n         Value::Number(n) => n.to_string(),\n@@ -586,6 +603,42 @@ mod tests {\n         );\n     }","is_error":false}]},"uuid":"14e06edd-249d-4898-b930-cc2d38160287","timestamp":"2026-09-17T13:59:06.920Z","toolUseResult":{"stdout":"diff --git a/crates/core/src/lib.rs b/crates/core/src/lib.rs\nindex 4b92828b..6c8d988f 100644\n--- a/crates/core/src/lib.rs\n+++ b/crates/core/src/lib.rs\n@@ -176,13 +176,13 @@ pub use transforming_source::TransformingSource;\n #[cfg(feature = \"transform-tree-flatten\")]\n pub use tree::{AncestorsSpec, ColumnsSpec, CompiledTreeFlatten, TreeFlattenSpec};\n pub use util::redact_uri_credentials;\n-pub use verify::{IntegrityCheck, LengthCheck, VerifyingReader};\n+pub use verify::{IntegrityCheck, LengthCheck, ObjectVerifySpec, VerifyingReader};\n pub use window::{\n     WINDOW_PLACEHOLDER, Window, WindowBind, WindowSpec, enumerate_windows, parse_step,\n };\n pub use write_mode::{\n     DeleteMarker, KeyTuple, OverwriteScope, WriteMode, WritePlan, WriteSpec, key_to_doc_id,\n-    key_to_filter, plan_writes,\n+    key_to_filter, plan_writes, sql_literal,\n };\n #[cfg(feature = \"transform-zip-columns\")]\n pub use zip_columns::{CompiledZipColumns, ZipColumnsSpec};\ndiff --git a/crates/core/src/pipeline.rs b/crates/core/src/pipeline.rs\nindex b4f41d24..22daa93f 100644\n--- a/crates/core/src/pipeline.rs\n+++ b/crates/core/src/pipeline