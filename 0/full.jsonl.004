{"type":"file-history-delta","messageId":"9a4ae1ef-e000-4173-966c-cae91db10ceb","snapshotMessageId":"523e9de6-5df2-4f5a-adb5-26831d3c055f","trackingPath":"crates/source/postgres/tests/fault_injection.rs","backup":{"backupFileName":null,"version":1,"backupTime":"2026-09-18T05:02:29.059Z","realParentDir":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream/crates/source/postgres/tests"},"timestamp":"2026-09-18T05:02:29.060Z"}
{"parentUuid":"a84febe9-1e26-4e57-849c-eb01583074d5","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011CfAKNysu9ZhP7rBPCLj1u","type":"message","role":"assistant","content":[{"type":"text","text":"Now E1's container tier. Rather than toxiproxy, killing the container mid-run is a more realistic and dependency-free way to cut a live connection:"}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4963,"cache_read_input_tokens":653958,"output_tokens":3538,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4963,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3538,"cache_read_input_tokens":653958,"cache_creation_input_tokens":4963,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4963},"type":"message"}],"speed":"standard"},"diagnostics":null,"context_management":null},"apiBlockIndex":0,"requestId":"req_011CfAKNxvMNDgdBbxPK444x","type":"assistant","uuid":"1bbb4c74-74dc-4d50-ab85-2ec2f7e4b6a7","timestamp":"2026-09-18T05:01:49.884Z","effort":"high","perTurnEffort":null,"session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.267","gitBranch":"fix/reliability-job-always-runs","slug":"linear-noodling-leaf"}
{"parentUuid":"1bbb4c74-74dc-4d50-ab85-2ec2f7e4b6a7","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011CfAKNysu9ZhP7rBPCLj1u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018WGDGSrNhJKca6Nn4r8o7g","name":"Write","input":{"file_path":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream/crates/source/postgres/tests/fault_injection.rs","content":"//! #651 Category E1 — the container tier: a real connection cut mid-run.\n//!\n//! `crates/conformance/tests/reliability_fault_injection.rs` covers the engine\n//! *contract* with a scripted source, Docker-free, on every PR. What it cannot\n//! cover is the part that only a real driver exhibits: what `sqlx` does when\n//! the server disappears underneath an open cursor, and whether that surfaces\n//! as a typed error, a retry loop, or a hang.\n//!\n//! So this tier stops the Postgres container while a stream is open. That is a\n//! harder cut than a proxy's latency or bandwidth toxic — the socket dies with\n//! no FIN — and it needs no extra image, which keeps the suite runnable\n//! anywhere Docker is.\n//!\n//! The obligations under test are the same three as the engine tier:\n//!\n//! 1. the run **fails**, rather than reporting success on partial data;\n//! 2. it fails with a **typed** error naming the source, not a panic;\n//! 3. it **terminates** — asserted under a hard ceiling, because a retry loop\n//!    with no bound is indistinguishable from a hang to whoever is watching.\n\nuse std::time::Duration;\n\nuse faucet_conformance::doubles::TestSink;\nuse faucet_core::{Pipeline, Source};\nuse faucet_source_postgres::{PostgresSource, PostgresSourceConfig};\nuse testcontainers::{ContainerAsync, ImageExt, runners::AsyncRunner};\nuse testcontainers_modules::postgres::Postgres;\n\n/// Hard ceiling for every run here. A cut connection must resolve well inside\n/// this; exceeding it is the hang regression, reported as such rather than as\n/// an opaque suite timeout.\nconst MUST_FINISH_WITHIN: Duration = Duration::from_secs(90);\n\nasync fn within<F: std::future::Future>(label: &str, fut: F) -> F::Output {\n    match tokio::time::timeout(MUST_FINISH_WITHIN, fut).await {\n        Ok(v) => v,\n        Err(_) => panic!(\n            \"{label} did not finish within {MUST_FINISH_WITHIN:?}. A run that never \\\n             terminates after its connection dies is indistinguishable from a hang — an \\\n             operator cannot tell it from a slow pipeline, which is why this ceiling exists.\"\n        ),\n    }\n}\n\nasync fn start_postgres() -> (ContainerAsync<Postgres>, String) {\n    let container: ContainerAsync<Postgres> = Postgres::default()\n        .with_tag(\"16-alpine\")\n        .start()\n        .await\n        .expect(\"postgres container start\");\n    let port = container\n        .get_host_port_ipv4(5432)\n        .await\n        .expect(\"postgres port\");\n    let url = format!(\"REDACTED\");\n    (container, url)\n}\n\n/// Seed `rows` rows so a streaming read spans several pages.\nasync fn seed(url: &str, rows: i64) {\n    let pool = sqlx::PgPool::connect(url).await.expect(\"pool\");\n    sqlx::query(\"CREATE TABLE big (id BIGINT PRIMARY KEY, payload TEXT)\")\n        .execute(&pool)\n        .await\n        .expect(\"create\");\n    sqlx::query(\n        \"INSERT INTO big (id, payload) \\\n         SELECT g, repeat('x', 200) FROM generate_series(1, $1) AS g\",\n    )\n    .bind(rows)\n    .execute(&pool)\n    .await\n    .expect(\"seed\");\n    pool.close().await;\n}\n\nfn source(url: &str, batch: usize) -> PostgresSource {\n    PostgresSource::new(\n        PostgresSourceConfig::new(url, \"SELECT id, payload FROM big ORDER BY id\")\n            .with_batch_size(batch),\n    )\n}\n\n#[tokio::test]\nasync fn a_connection_cut_mid_stream_fails_the_run_and_terminates() {\n    let (container, url) = start_postgres().await;\n    seed(&url, 40_000).await;\n\n    let src = source(&url, 100);\n    let sink = TestSink::new();\n\n    // Stop the server shortly after the read starts, while a cursor is open.\n    let killer = tokio::spawn(async move {\n        tokio::time::sleep(Duration::from_millis(400)).await;\n        container.stop().await.expect(\"stop the container\");\n        // Keep the handle alive until here so the container is not dropped (and\n        // removed) before we mean to stop it.\n        container\n    });\n\n    let outcome = within(\n        \"connection cut mid-stream\",\n        Pipeline::new(&src, &sink).run(),\n    )\n    .await;\n    let _ = killer.await;\n\n    let err = match outcome {\n        Err(e) => e,\n        Ok(result) => panic!(\n            \"the run reported SUCCESS after its connection was cut, having written {} of \\\n             40000 rows — a truncated dataset presented as complete is the worst outcome \\\n             available here\",\n            result.records_written\n        ),\n    };\n\n    // Typed, and attributed to the source — not a bare string a caller would\n    // have to grep, and not a panic.\n    assert!(\n        matches!(\n            err,\n            faucet_core::FaucetError::Source(_) | faucet_core::FaucetError::Custom(_)\n        ),\n        \"a dead connection must surface as a typed source failure, got {err:?}\"\n    );\n\n    // Whatever it wrote is a prefix of the data, never more than the source had.\n    let written = sink.records().len();\n    assert!(\n        written < 40_000,\n        \"the read was supposed to be cut short, but {written} rows arrived\"\n    );\n}\n\n#[tokio::test]\nasync fn a_cut_before_the_first_page_fails_cleanly_rather_than_hanging() {\n    // The connect-time variant: the server is already gone when the pipeline\n    // starts. A driver configured with an unbounded connect retry would hang\n    // here, which is the failure mode the ceiling catches.\n    let (container, url) = start_postgres().await;\n    seed(&url, 100).await;\n    container.stop().await.expect(\"stop the container\");\n\n    let src = source(&url, 10);\n    let sink = TestSink::new();\n\n    let err = within(\n        \"connect against a stopped server\",\n        Pipeline::new(&src, &sink).run(),\n    )\n    .await\n    .expect_err(\"connecting to a stopped server must fail\");\n\n    assert!(\n        !matches!(err, faucet_core::FaucetError::Config(_)),\n        \"an unreachable server is a runtime failure, not a config one: {err:?}\"\n    );\n    assert!(\n        sink.records().is_empty(),\n        \"nothing may be written when the source never connected\"\n    );\n}\n\n#[tokio::test]\nasync fn the_healthy_path_is_the_control_and_reads_every_row() {\n    // Without this, a bug that made every run fail early would leave both tests\n    // above passing for entirely the wrong reason.\n    let (_c, url) = start_postgres().await;\n    seed(&url, 2_500).await;\n\n    let src = source(&url, 100);\n    let sink = TestSink::new();\n\n    let result = within(\"healthy control run\", Pipeline::new(&src, &sink).run())\n        .await\n        .expect(\"a healthy run completes\");\n\n    assert_eq!(\n        result.records_written, 2_500,\n        \"the control must read the whole table, or the cut-short assertions above \\\n         are not measuring anything\"\n    );\n    assert_eq!(sink.records().len(), 2_500);\n}\n\n#[tokio::test]\nasync fn a_cut_connection_never_reports_a_bookmark_it_cannot_back() {\n    // The durability tie-in: an incremental read that dies mid-stream must not\n    // hand back a bookmark covering rows the sink never confirmed. The engine\n    // tier asserts this with a scripted source; here the failure is a real\n    // socket death partway through a real cursor.\n    let (container, url) = start_postgres().await;\n    seed(&url, 40_000).await;\n\n    let src = source(&url, 100);\n    let sink = TestSink::new();\n\n    let killer = tokio::spawn(async move {\n        tokio::time::sleep(Duration::from_millis(400)).await;\n        container.stop().await.expect(\"stop\");\n        container\n    });\n\n    let outcome = within(\n        \"cut connection bookmark\",\n        Pipeline::new(&src, &sink).run(),\n    )\n    .await;\n    let _ = killer.await;\n\n    match outcome {\n        // The expected path: a failure carries no bookmark for a caller to\n        // persist.\n        Err(_) => {}\n        Ok(result) => {\n            let written = sink.records().len();\n            panic!(\n                \"the run returned Ok(bookmark = {:?}) after its connection died, with {written} \\\n                 rows written. Persisting that bookmark would skip every unread row on the \\\n                 next run.\",\n                result.bookmark\n            );\n        }\n    }\n}\n\n/// Guards the premise of this file: the source must actually stream in pages\n/// rather than buffering the whole table, or \"cut it mid-stream\" is not a thing\n/// that can happen and every test above is vacuous.\n#[tokio::test]\nasync fn the_source_streams_in_pages_so_a_mid_stream_cut_is_possible() {\n    use futures::StreamExt;\n\n    let (_c, url) = start_postgres().await;\n    seed(&url, 1_000).await;\n    let src = source(&url, 100);\n\n    let ctx = std::collections::HashMap::new();\n    let mut pages = src.stream_pages(&ctx, 100);\n    let first = pages\n        .next()\n        .await\n        .expect(\"at least one page\")\n        .expect(\"the first page reads\");\n\n    assert!(\n        first.records.len() < 1_000,\n        \"the source buffered the whole table into one page ({} records), so there is no \\\n         mid-stream point at which to cut the connection\",\n        first.records.len()\n    );\n    assert!(!first.records.is_empty());\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4963,"cache_read_input_tokens":653958,"output_tokens":3538,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4963,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3538,"cache_read_input_tokens":653958,"cache_creation_input_tokens":4963,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4963},"type":"message"}],"speed":"standard"},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_018WGDGSrNhJKca6Nn4r8o7g":{"file_path":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream/crates/source/postgres/tests/fault_injection.rs","content":"//! #651 Category E1 — the container tier: a real connection cut mid-run.\n//!\n//! `crates/conformance/tests/reliability_fault_injection.rs` covers the engine\n//! *contract* with a scripted source, Docker-free, on every PR. What it cannot\n//! cover is the part that only a real driver exhibits: what `sqlx` does when\n//! the server disappears underneath an open cursor, and whether that surfaces\n//! as a typed error, a retry loop, or a hang.\n//!\n//! So this tier stops the Postgres container while a stream is open. That is a\n//! harder cut than a proxy's latency or bandwidth toxic — the socket dies with\n//! no FIN — and it needs no extra image, which keeps the suite runnable\n//! anywhere Docker is.\n//!\n//! The obligations under test are the same three as the engine tier:\n//!\n//! 1. the run **fails**, rather than reporting success on partial data;\n//! 2. it fails with a **typed** error naming the source, not a panic;\n//! 3. it **terminates** — asserted under a hard ceiling, because a retry loop\n//!    with no bound is indistinguishable from a hang to whoever is watching.\n\nuse std::time::Duration;\n\nuse faucet_conformance::doubles::TestSink;\nuse faucet_core::{Pipeline, Source};\nuse faucet_source_postgres::{PostgresSource, PostgresSourceConfig};\nuse testcontainers::{ContainerAsync, ImageExt, runners::AsyncRunner};\nuse testcontainers_modules::postgres::Postgres;\n\n/// Hard ceiling for every run here. A cut connection must resolve well inside\n/// this; exceeding it is the hang regression, reported as such rather than as\n/// an opaque suite timeout.\nconst MUST_FINISH_WITHIN: Duration = Duration::from_secs(90);\n\nasync fn within<F: std::future::Future>(label: &str, fut: F) -> F::Output {\n    match tokio::time::timeout(MUST_FINISH_WITHIN, fut).await {\n        Ok(v) => v,\n        Err(_) => panic!(\n            \"{label} did not finish within {MUST_FINISH_WITHIN:?}. A run that never \\\n             terminates after its connection dies is indistinguishable from a hang — an \\\n             operator cannot tell it from a slow pipeline, which is why this ceiling exists.\"\n        ),\n    }\n}\n\nasync fn start_postgres() -> (ContainerAsync<Postgres>, String) {\n    let container: ContainerAsync<Postgres> = Postgres::default()\n        .with_tag(\"16-alpine\")\n        .start()\n        .await\n        .expect(\"postgres container start\");\n    let port = container\n        .get_host_port_ipv4(5432)\n        .await\n        .expect(\"postgres port\");\n    let url = format!(\"REDACTED\");\n    (container, url)\n}\n\n/// Seed `rows` rows so a streaming read spans several pages.\nasync fn seed(url: &str, rows: i64) {\n    let pool = sqlx::PgPool::connect(url).await.expect(\"pool\");\n    sqlx::query(\"CREATE TABLE big (id BIGINT PRIMARY KEY, payload TEXT)\")\n        .execute(&pool)\n        .await\n        .expect(\"create\");\n    sqlx::query(\n        \"INSERT INTO big (id, payload) \\\n         SELECT g, repeat('x', 200) FROM generate_series(1, $1) AS g\",\n    )\n    .bind(rows)\n    .execute(&pool)\n    .await\n    .expect(\"seed\");\n    pool.close().await;\n}\n\nfn source(url: &str, batch: usize) -> PostgresSource {\n    PostgresSource::new(\n        PostgresSourceConfig::new(url, \"SELECT id, payload FROM big ORDER BY id\")\n            .with_batch_size(batch),\n    )\n}\n\n#[tokio::test]\nasync fn a_connection_cut_mid_stream_fails_the_run_and_terminates() {\n    let (container, url) = start_postgres().await;\n    seed(&url, 40_000).await;\n\n    let src = source(&url, 100);\n    let sink = TestSink::new();\n\n    // Stop the server shortly after the read starts, while a cursor is open.\n    let killer = tokio::spawn(async move {\n        tokio::time::sleep(Duration::from_millis(400)).await;\n        container.stop().await.expect(\"stop the container\");\n        // Keep the handle alive until here so the container is not dropped (and\n        // removed) before we mean to stop it.\n        container\n    });\n\n    let outcome = within(\n        \"connection cut mid-stream\",\n        Pipeline::new(&src, &sink).run(),\n    )\n    .await;\n    let _ = killer.await;\n\n    let err = match outcome {\n        Err(e) => e,\n        Ok(result) => panic!(\n            \"the run reported SUCCESS after its connection was cut, having written {} of \\\n             40000 rows — a truncated dataset presented as complete is the worst outcome \\\n             available here\",\n            result.records_written\n        ),\n    };\n\n    // Typed, and attributed to the source — not a bare string a caller would\n    // have to grep, and not a panic.\n    assert!(\n        matches!(\n            err,\n            faucet_core::FaucetError::Source(_) | faucet_core::FaucetError::Custom(_)\n        ),\n        \"a dead connection must surface as a typed source failure, got {err:?}\"\n    );\n\n    // Whatever it wrote is a prefix of the data, never more than the source had.\n    let written = sink.records().len();\n    assert!(\n        written < 40_000,\n        \"the read was supposed to be cut short, but {written} rows arrived\"\n    );\n}\n\n#[tokio::test]\nasync fn a_cut_before_the_first_page_fails_cleanly_rather_than_hanging() {\n    // The connect-time variant: the server is already gone when the pipeline\n    // starts. A driver configured with an unbounded connect retry would hang\n    // here, which is the failure mode the ceiling catches.\n    let (container, url) = start_postgres().await;\n    seed(&url, 100).await;\n    container.stop().await.expect(\"stop the container\");\n\n    let src = source(&url, 10);\n    let sink = TestSink::new();\n\n    let err = within(\n        \"connect against a stopped server\",\n        Pipeline::new(&src, &sink).run(),\n    )\n    .await\n    .expect_err(\"connecting to a stopped server must fail\");\n\n    assert!(\n        !matches!(err, faucet_core::FaucetError::Config(_)),\n        \"an unreachable server is a runtime failure, not a config one: {err:?}\"\n    );\n    assert!(\n        sink.records().is_empty(),\n        \"nothing may be written when the source never connected\"\n    );\n}\n\n#[tokio::test]\nasync fn the_healthy_path_is_the_control_and_reads_every_row() {\n    // Without this, a bug that made every run fail early would leave both tests\n    // above passing for entirely the wrong reason.\n    let (_c, url) = start_postgres().await;\n    seed(&url, 2_500).await;\n\n    let src = source(&url, 100);\n    let sink = TestSink::new();\n\n    let result = within(\"healthy control run\", Pipeline::new(&src, &sink).run())\n        .await\n        .expect(\"a healthy run completes\");\n\n    assert_eq!(\n        result.records_written, 2_500,\n        \"the control must read the whole table, or the cut-short assertions above \\\n         are not measuring anything\"\n    );\n    assert_eq!(sink.records().len(), 2_500);\n}\n\n#[tokio::test]\nasync fn a_cut_connection_never_reports_a_bookmark_it_cannot_back() {\n    // The durability tie-in: an incremental read that dies mid-stream must not\n    // hand back a bookmark covering rows the sink never confirmed. The engine\n    // tier asserts this with a scripted source; here the failure is a real\n    // socket death partway through a real cursor.\n    let (container, url) = start_postgres().await;\n    seed(&url, 40_000).await;\n\n    let src = source(&url, 100);\n    let sink = TestSink::new();\n\n    let killer = tokio::spawn(async move {\n        tokio::time::sleep(Duration::from_millis(400)).await;\n        container.stop().await.expect(\"stop\");\n        container\n    });\n\n    let outcome = within(\n        \"cut connection bookmark\",\n        Pipeline::new(&src, &sink).run(),\n    )\n    .await;\n    let _ = killer.await;\n\n    match outcome {\n        // The expected path: a failure carries no bookmark for a caller to\n        // persist.\n        Err(_) => {}\n        Ok(result) => {\n            let written = sink.records().len();\n            panic!(\n                \"the run returned Ok(bookmark = {:?}) after its connection died, with {written} \\\n                 rows written. Persisting that bookmark would skip every unread row on the \\\n                 next run.\",\n                result.bookmark\n            );\n        }\n    }\n}\n\n/// Guards the premise of this file: the source must actually stream in pages\n/// rather than buffering the whole table, or \"cut it mid-stream\" is not a thing\n/// that can happen and every test above is vacuous.\n#[tokio::test]\nasync fn the_source_streams_in_pages_so_a_mid_stream_cut_is_possible() {\n    use futures::StreamExt;\n\n    let (_c, url) = start_postgres().await;\n    seed(&url, 1_000).await;\n    let src = source(&url, 100);\n\n    let ctx = std::collections::HashMap::new();\n    let mut pages = src.stream_pages(&ctx, 100);\n    let first = pages\n        .next()\n        .await\n        .expect(\"at least one page\")\n        .expect(\"the first page reads\");\n\n    assert!(\n        first.records.len() < 1_000,\n        \"the source buffered the whole table into one page ({} records), so there is no \\\n         mid-stream point at which to cut the connection\",\n        first.records.len()\n    );\n    assert!(!first.records.is_empty());\n}\n"}},"apiBlockIndex":1,"requestId":"req_011CfAKNxvMNDgdBbxPK444x","type":"assistant","uuid":"9a4ae1ef-e000-4173-966c-cae91db10ceb","timestamp":"2026-09-18T05:02:29.030Z","effort":"high","perTurnEffort":null,"session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.267","gitBranch":"fix/reliability-job-always-runs","slug":"linear-noodling-leaf"}
{"parentUuid":"9a4ae1ef-e000-4173-966c-cae91db10ceb","isSidechain":false,"promptId":"cc1a5946-b99d-4ce5-8bfb-50d887abccb7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018WGDGSrNhJKca6Nn4r8o7g","type":"tool_result","content":"File created successfully at: /Users/c-sikawats/Documents/GitHub/Personal/faucet-stream/crates/source/postgres/tests/fault_injection.rs (file state is current in your context — no need to Read it back)"}]},"uuid":"a93defbc-8c01-4fb0-ab1b-abec08c900cd","timestamp":"2026-09-18T05:02:29.467Z","toolUseResult":{"type":"create","filePath":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream/crates/source/postgres/tests/fault_injection.rs","content":"//! #651 Category E1 — the container tier: a real connection cut mid-run.\n//!\n//! `crates/conformance/tests/reliability_fault_injection.rs` covers the engine\n//! *contract* with a scripted source, Docker-free, on every PR. What it cannot\n//! cover is the part that only a real driver exhibits: what `sqlx` does when\n//! the server disappears underneath an open cursor, and whether that surfaces\n//! as a typed error, a retry loop, or a hang.\n//!\n//! So this tier stops the Postgres container while a stream is open. That is a\n//! harder cut than a proxy's latency or bandwidth toxic — the socket dies with\n//! no FIN — and it needs no extra image, which keeps the suite runnable\n//! anywhere Docker is.\n//!\n//! The obligations under test are the same three as the engine tier:\n//!\n//! 1. the run **fails**, rather than reporting success on partial data;\n//! 2. it fails with a **typed** error naming the source, not a panic;\n//! 3. it **terminates** — asserted under a hard ceiling, because a retry loop\n//!    with no bound is indistinguishable from a hang to whoever is watching.\n\nuse std::time::Duration;\n\nuse faucet_conformance::doubles::TestSink;\nuse faucet_core::{Pipeline, Source};\nuse faucet_source_postgres::{PostgresSource, PostgresSourceConfig};\nuse testcontainers::{ContainerAsync, ImageExt, runners::AsyncRunner};\nuse testcontainers_modules::postgres::Postgres;\n\n/// Hard ceiling for every run here. A cut connection must resolve well inside\n/// this; exceeding it is the hang regression, reported as such rather than as\n/// an opaque suite timeout.\nconst MUST_FINISH_WITHIN: Duration = Duration::from_secs(90);\n\nasync fn within<F: std::future::Future>(label: &str, fut: F) -> F::Output {\n    match tokio::time::timeout(MUST_FINISH_WITHIN, fut).await {\n        Ok(v) => v,\n        Err(_) => panic!(\n            \"{label} did not finish within {MUST_FINISH_WITHIN:?}. A run that never \\\n             terminates after its connection dies is indistinguishable from a hang — an \\\n             operator cannot tell it from a slow pipeline, which is why this ceiling exists.\"\n        ),\n    }\n}\n\nasync fn start_postgres() -> (ContainerAsync<Postgres>, String) {\n    let container: ContainerAsync<Postgres> = Postgres::default()\n        .with_tag(\"16-alpine\")\n        .start()\n        .await\n        .expect(\"postgres container start\");\n    let port = container\n        .get_host_port_ipv4(5432)\n        .await\n        .expect(\"postgres port\");\n    let url = format!(\"REDACTED\");\n    (container, url)\n}\n\n/// Seed `rows` rows so a streaming read spans several pages.\nasync fn seed(url: &str, rows: i64) {\n    let pool = sqlx::PgPool::connect(url).await.expect(\"pool\");\n    sqlx::query(\"CREATE TABLE big (id BIGINT PRIMARY KEY, payload TEXT)\")\n        .execute(&pool)\n        .await\n        .expect(\"create\");\n    sqlx::query(\n        \"INSERT INTO big (id, payload) \\\n         SELECT g, repeat('x', 200) FROM generate_series(1, $1) AS g\",\n    )\n    .bind(rows)\n    .execute(&pool)\n    .await\n    .expect(\"seed\");\n    pool.close().await;\n}\n\nfn source(url: &str, batch: usize) -> PostgresSource {\n    PostgresSource::new(\n        PostgresSourceConfig::new(url, \"SELECT id, payload FROM big ORDER BY id\")\n            .with_batch_size(batch),\n    )\n}\n\n#[tokio::test]\nasync fn a_connection_cut_mid_stream_fails_the_run_and_terminates() {\n    let (container, url) = start_postgres().await;\n    seed(&url, 40_000).await;\n\n    let src = source(&url, 100);\n    let sink = TestSink::new();\n\n    // Stop the server shortly after the read starts, while a cursor is open.\n    let killer = tokio::spawn(async move {\n        tokio::time::sleep(Duration::from_millis(400)).await;\n        container.stop().await.expect(\"stop the container\");\n        // Keep the handle alive until here so the container is not dropped (and\n        // removed) before we mean to stop it.\n        container\n    });\n\n    let outcome = within(\n        \"connection cut mid-stream\",\n        Pipeline::new(&src, &sink).run(),\n    )\n    .await;\n    let _ = killer.await;\n\n    let err = match outcome {\n        Err(e) => e,\n        Ok(result) => panic!(\n            \"the run reported SUCCESS after its connection was cut, having written {} of \\\n             40000 rows — a truncated dataset presented as complete is the worst outcome \\\n             available here\",\n            result.records_written\n        ),\n    };\n\n    // Typed, and attributed to the source — not a bare string a caller would\n    // have to grep, and not a panic.\n    assert!(\n        matches!(\n            err,\n            faucet_core::FaucetError::Source(_) | faucet_core::FaucetError::Custom(_)\n        ),\n        \"a dead connection must surface as a typed source failure, got {err:?}\"\n    );\n\n    // Whatever it wrote is a prefix of the data, never more than the source had.\n    let written = sink.records().len();\n    assert!(\n        written < 40_000,\n        \"the read was supposed to be cut short, but {written} rows arrived\"\n    );\n}\n\n#[tokio::test]\nasync fn a_cut_before_the_first_page_fails_cleanly_rather_than_hanging() {\n    // The connect-time variant: the server is already gone when the pipeline\n    // starts. A driver configured with an unbounded connect retry would hang\n    // here, which is the failure mode the ceiling catches.\n    let (container, url) = start_postgres().await;\n    seed(&url, 100).await;\n    container.stop().await.expect(\"stop the container\");\n\n    let src = source(&url, 10);\n    let sink = TestSink::new();\n\n    let err = within(\n        \"connect against a stopped server\",\n        Pipeline::new(&src, &sink).run(),\n    )\n    .await\n    .expect_err(\"connecting to a stopped server must fail\");\n\n    assert!(\n        !matches!(err, faucet_core::FaucetError::Config(_)),\n        \"an unreachable server is a runtime failure, not a config one: {err:?}\"\n    );\n    assert!(\n        sink.records().is_empty(),\n        \"nothing may be written when the source never connected\"\n    );\n}\n\n#[tokio::test]\nasync fn the_healthy_path_is_the_control_and_reads_every_row() {\n    // Without this, a bug that made every run fail early would leave both tests\n    // above passing for entirely the wrong reason.\n    let (_c, url) = start_postgres().await;\n    seed(&url, 2_500).await;\n\n    let src = source(&url, 100);\n    let sink = TestSink::new();\n\n    let result = within(\"healthy control run\", Pipeline::new(&src, &sink).run())\n        .await\n        .expect(\"a healthy run completes\");\n\n    assert_eq!(\n        result.records_written, 2_500,\n        \"the control must read the whole table, or the cut-short assertions above \\\n         are not measuring anything\"\n    );\n    assert_eq!(sink.records().len(), 2_500);\n}\n\n#[tokio::test]\nasync fn a_cut_connection_never_reports_a_bookmark_it_cannot_back() {\n    // The durability tie-in: an incremental read that dies mid-stream must not\n    // hand back a bookmark covering rows the sink never confirmed. The engine\n    // tier asserts this with a scripted source; here the failure is a real\n    // socket death partway through a real cursor.\n    let (container, url) = start_postgres().await;\n    seed(&url, 40_000).await;\n\n    let src = source(&url, 100);\n    let sink = TestSink::new();\n\n    let killer = tokio::spawn(async move {\n        tokio::time::sleep(Duration::from_millis(400)).await;\n        container.stop().await.expect(\"stop\");\n        container\n    });\n\n    let outcome = within(\n        \"cut connection bookmark\",\n        Pipeline::new(&src, &sink).run(),\n    )\n    .await;\n    let _ = killer.await;\n\n    match outcome {\n        // The expected path: a failure carries no bookmark for a caller to\n        // persist.\n        Err(_) => {}\n        Ok(result) => {\n            let written = sink.records().len();\n            panic!(\n                \"the run returned Ok(bookmark = {:?}) after its connection died, with {written} \\\n                 rows written. Persisting that bookmark would skip every unread row on the \\\n                 next run.\",\n                result.bookmark\n            );\n        }\n    }\n}\n\n/// Guards the premise of this file: the source must actually stream in pages\n/// rather than buffering the whole table, or \"cut it mid-stream\" is not a thing\n/// that can happen and every test above is vacuous.\n#[tokio::test]\nasync fn the_source_streams_in_pages_so_a_mid_stream_cut_is_possible() {\n    use futures::StreamExt;\n\n    let (_c, url) = start_postgres().await;\n    seed(&url, 1_000).await;\n    let src = source(&url, 100);\n\n    let ctx = std::collections::HashMap::new();\n    let mut pages = src.stream_pages(&ctx, 100);\n    let first = pages\n        .next()\n        .await\n        .expect(\"at least one page\")\n        .expect(\"the first page reads\");\n\n    assert!(\n        first.records.len() < 1_000,\n        \"the source buffered the whole table into one page ({} records), so there is no \\\n         mid-stream point at which to cut the connection\",\n        first.records.len()\n    );\n    assert!(!first.records.is_empty());\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"9a4ae1ef-e000-4173-966c-cae91db10ceb","session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.267","gitBranch":"fix/reliability-job-always-runs","slug":"linear-noodling-leaf"}
