{"parentUuid":"4a541c22-a38b-40d5-b461-b0e9ad8a8542","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_016uPQV2LamQB3tQNe69gkuC","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"55398c64-7c65-40db-9b68-886111a86d7f\\\",\\\"cwd\\\":\\\"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream\\\",\\\"project\\\":\\\"faucet-stream\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/c-sikawats/.claude/plugins/cache/claude-code-warp/warp/2.2.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":250},"type":"attachment","uuid":"cd9ca167-48a6-41d1-ac6b-92dded0f9f24","timestamp":"2026-09-18T05:03:02.101Z","session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.267","gitBranch":"fix/reliability-job-always-runs","slug":"linear-noodling-leaf"}
{"parentUuid":"cd9ca167-48a6-41d1-ac6b-92dded0f9f24","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream/crates/source/postgres/tests/fault_injection.rs","snippet":"1\t//! #651 Category E1 — the container tier: a real connection cut mid-run.\n2\t//!\n3\t//! `crates/conformance/tests/reliability_fault_injection.rs` covers the engine\n4\t//! *contract* with a scripted source, Docker-free, on every PR. What it cannot\n5\t//! cover is the part that only a real driver exhibits: what `sqlx` does when\n6\t//! the server disappears underneath an open cursor, and whether that surfaces\n7\t//! as a typed error, a retry loop, or a hang.\n8\t//!\n9\t//! So this tier stops the Postgres container while a stream is open. That is a\n10\t//! harder cut than a proxy's latency or bandwidth toxic — the socket dies with\n11\t//! no FIN — and it needs no extra image, which keeps the suite runnable\n12\t//! anywhere Docker is.\n13\t//!\n14\t//! The obligations under test are the same three as the engine tier:\n15\t//!\n16\t//! 1. the run **fails**, rather than reporting success on partial data;\n17\t//! 2. it fails with a **typed** error naming the source, not a panic;\n18\t//! 3. it **terminates** — asserted under a hard ceiling, because a retry loop\n19\t//!    with no bound is indistinguishable from a hang to whoever is watching.\n20\t\n21\tuse std::time::Duration;\n22\t\n23\tuse faucet_conformance::doubles::TestSink;\n24\tuse faucet_core::{Pipeline, Source};\n25\tuse faucet_source_postgres::{PostgresSource, PostgresSourceConfig};\n26\tuse testcontainers::{ContainerAsync, ImageExt, runners::AsyncRunner};\n27\tuse testcontainers_modules::postgres::Postgres;\n28\t\n29\t/// Hard ceiling for every run here. A cut connection must resolve well inside\n30\t/// this; exceeding it is the hang regression, reported as such rather than as\n31\t/// an opaque suite timeout.\n32\tconst MUST_FINISH_WITHIN: Duration = Duration::from_secs(90);\n33\t\n34\tasync fn within<F: std::future::Future>(label: &str, fut: F) -> F::Output {\n35\t    match tokio::time::timeout(MUST_FINISH_WITHIN, fut).await {\n36\t        Ok(v) => v,\n37\t        Err(_) => panic!(\n38\t            \"{label} did not finish within {MUST_FINISH_WITHIN:?}. A run that never \\\n39\t             terminates after its connection dies is indistinguishable from a hang — an \\\n40\t             operator cannot tell it from a slow pipeline, which is why this ceiling exists.\"\n41\t        ),\n42\t    }\n43\t}\n44\t\n45\tasync fn start_postgres() -> (ContainerAsync<Postgres>, String) {\n46\t    let container: ContainerAsync<Postgres> = Postgres::default()\n47\t        .with_tag(\"16-alpine\")\n48\t        .start()\n49\t        .await\n50\t        .expect(\"postgres container start\");\n51\t    let port = container\n52\t        .get_host_port_ipv4(5432)\n53\t        .await\n54\t        .expect(\"postgres port\");\n55\t    let url = format!(\"REDACTED\");\n56\t    (container, url)\n57\t}\n58\t\n59\t/// Seed `rows` rows so a streaming read spans several pages.\n60\tasync fn seed(url: &str, rows: i64) {\n61\t    let pool = sqlx::PgPool::connect(url).await.expect(\"pool\");\n62\t    sqlx::query(\"CREATE TABLE big (id BIGINT PRIMARY KEY, payload TEXT)\")\n63\t        .execute(&pool)\n64\t        .await\n65\t        .expect(\"create\");\n66\t    sqlx::query(\n67\t        \"INSERT INTO big (id, payload) \\\n68\t         SELECT g, repeat('x', 200) FROM generate_series(1, $1) AS g\",\n69\t    )\n70\t    .bind(rows)\n71\t    .execute(&pool)\n72\t    .await\n73\t    .expect(\"seed\");\n74\t    pool.close().await;\n75\t}\n76\t\n77\tasync fn source(url: &str, batch: usize) -> PostgresSource {\n78\t    PostgresSource::new(\n79\t        PostgresSourceConfig::new(url, \"SELECT id, payload FROM big ORDER BY id\")\n80\t            .with_batch_size(batch),\n81\t    )\n82\t    .await\n83\t    .expect(\"source\")\n84\t}\n85\t\n86\t#[tokio::test]\n87\tasync fn a_connection_cut_mid_stream_fails_the_run_and_terminates() {\n88\t    let (container, url) = start_postgres().await;\n89\t    seed(&url, 40_000).await;\n90\t\n91\t    let src = source(&url, 100).await;\n92\t    let sink = TestSink::new();\n93\t\n94\t    // Stop the server shortly after the read starts, while a cursor is open.\n95\t    let killer = tokio::spawn(async move {\n96\t        tokio::time::sleep(Duration::from_millis(400)).await;\n97\t        container.stop().await.expect(\"stop the container\");\n98\t        // Keep the handle alive until here so the container is not dropped (and\n99\t        // removed) before we mean to stop it.\n100\t        container\n101\t    });\n102\t\n103\t    let outcome = within(\n104\t        \"connection cut mid-stream\",\n105\t        Pipeline::new(&src, &sink).run(),\n106\t    )\n107\t    .await;\n108\t    let _ = killer.await;\n109\t\n110\t    let err = match outcome {\n111\t        Err(e) => e,\n112\t        Ok(result) => panic!(\n113\t            \"the run reported SUCCESS after its connection was cut, having written {} of \\\n114\t             40000 rows — a truncated dataset presented as complete is the worst outcome \\\n115\t             available here\",\n116\t            result.records_written\n117\t        ),\n118\t    };\n119\t\n120\t    // Typed, and attributed to the source — not a bare string a caller would\n121\t    // have to grep, and not a panic.\n122\t    assert!(\n123\t        matches!(\n124\t            err,\n125\t            faucet_core::FaucetError::Source(_) | faucet_core::FaucetError::Custom(_)\n126\t        ),\n127\t        \"a dead connection must surface as a typed source failure, got {err:?}\"\n128\t    );\n129\t\n130\t    // Whatever it wrote is a prefix of the data, never more than the source had.\n131\t    let written = sink.len();\n132\t    assert!(\n133\t        written < 40_000,\n134\t        \"the read was supposed to be cut short, but {written} rows arrived\"\n135\t    );\n136\t}\n137\t\n138\t#[tokio::test]\n139\tasync fn a_cut_before_the_first_page_fails_cleanly_rather_than_hanging() {\n140\t    // The connect-time variant: the server is already gone when the pipeline\n141\t    // starts. A driver configured with an unbounded connect retry would hang\n142\t    // here, which is the failure mode the ceiling catches.\n143\t    let (container, url) = start_postgres().await;\n144\t    seed(&url, 100).await;\n145\t    container.stop().await.expect(\"stop the container\");\n146\t\n147\t    let src = source(&url, 10).await;\n148\t    let sink = TestSink::new();\n149\t\n150\t    let err = within(\n151\t        \"connect against a stopped server\",\n152\t        Pipeline::new(&src, &sink).run(),\n153\t    )\n154\t    .await\n155\t    .expect_err(\"connecting to a stopped server must fail\");\n156\t\n157\t    assert!(\n158\t        !matches!(err, faucet_core::FaucetError::Config(_)),\n159\t        \"an unreachable server is a runtime failure, not a config one: {err:?}\"\n160\t    );\n161\t    assert!(\n162\t        sink.is_empty(),\n163\t        \"nothing may be written when the source never connected\"\n164\t    );\n165\t}\n166\t\n167\t#[tokio::test]\n168\tasync fn the_healthy_path_is_the_control_and_reads_every_row() {\n169\t    // Without this, a bug that made every run fail early would leave both tests\n170\t    // above passing for entirely the wrong reason.\n171\t    let (_c, url) = start_postgres().await;\n172\t    seed(&url, 2_500).await;\n173\t\n174\t    let src = source(&url, 100).await;\n175\t    let sink = TestSink::new();\n176\t\n177\t    let result = within(\"healthy control run\", Pipeline::new(&src, &sink).run())\n178\t        .await\n179\t        .expect(\"a healthy run completes\");\n180\t\n181\t    assert_eq!(\n182\t        result.records_written, 2_500,\n183\t        \"the control must read the whole table, or the cut-short assertions above \\\n184\t         are not measuring anything\"\n185\t    );\n186\t    assert_eq!(sink.len(), 2_500);\n187\t}\n188\t\n189\t#[tokio::test]\n190\tasync fn a_cut_connection_never_reports_a_bookmark_it_cannot_back() {\n191\t    // The durability tie-in: an incremental read that dies mid-stream must not\n192\t    // hand back a bookmark covering rows the sink never confirmed. The engine\n193\t    // tier asserts this with a scripted source; here the failure is a real\n194\t    // socket death partway through a real cursor.\n195\t    let (container, url) = start_postgres().await;\n196\t    seed(&url, 40_000).await;\n197\t\n198\t    let src = source(&url, 100).await;\n199\t    let sink = TestSink::new();\n200\t\n201\t    let killer = tokio::spawn(async move {\n202\t        tokio::time::sleep(Duration::from_millis(400)).await;\n203\t        container.stop().await.expect(\"stop\");\n204\t        container\n205\t    });\n206\t\n\n... [50 lines truncated] ..."},"type":"attachment","uuid":"64f3cf21-4d1b-4bbe-9cba-e7a6cd57a260","timestamp":"2026-09-18T05:03:02.120Z","rendered":[{"content":"<system-reminder>\nNote: /Users/c-sikawats/Documents/GitHub/Personal/faucet-stream/crates/source/postgres/tests/fault_injection.rs changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n1\t//! #651 Category E1 — the container tier: a real connection cut mid-run.\n2\t//!\n3\t//! `crates/conformance/tests/reliability_fault_injection.rs` covers the engine\n4\t//! *contract* with a scripted source, Docker-free, on every PR. What it cannot\n5\t//! cover is the part that only a real driver exhibits: what `sqlx` does when\n6\t//! the server disappears underneath an open cursor, and whether that surfaces\n7\t//! as a typed error, a retry loop, or a hang.\n8\t//!\n9\t//! So this tier stops the Postgres container while a stream is open. That is a\n10\t//! harder cut than a proxy's latency or bandwidth toxic — the socket dies with\n11\t//! no FIN — and it needs no extra image, which keeps the suite runnable\n12\t//! anywhere Docker is.\n13\t//!\n14\t//! The obligations under test are the same three as the engine tier:\n15\t//!\n16\t//! 1. the run **fails**, rather than reporting success on partial data;\n17\t//! 2. it fails with a **typed** error naming the source, not a panic;\n18\t//! 3. it **terminates** — asserted under a hard ceiling, because a retry loop\n19\t//!    with no bound is indistinguishable from a hang to whoever is watching.\n20\t\n21\tuse std::time::Duration;\n22\t\n23\tuse faucet_conformance::doubles::TestSink;\n24\tuse faucet_core::{Pipeline, Source};\n25\tuse faucet_source_postgres::{PostgresSource, PostgresSourceConfig};\n26\tuse testcontainers::{ContainerAsync, ImageExt, runners::AsyncRunner};\n27\tuse testcontainers_modules::postgres::Postgres;\n28\t\n29\t/// Hard ceiling for every run here. A cut connection must resolve well inside\n30\t/// this; exceeding it is the hang regression, reported as such rather than as\n31\t/// an opaque suite timeout.\n32\tconst MUST_FINISH_WITHIN: Duration = Duration::from_secs(90);\n33\t\n34\tasync fn within<F: std::future::Future>(label: &str, fut: F) -> F::Output {\n35\t    match tokio::time::timeout(MUST_FINISH_WITHIN, fut).await {\n36\t        Ok(v) => v,\n37\t        Err(_) => panic!(\n38\t            \"{label} did not finish within {MUST_FINISH_WITHIN:?}. A run that never \\\n39\t             terminates after its connection dies is indistinguishable from a hang — an \\\n40\t             operator cannot tell it from a slow pipeline, which is why this ceiling exists.\"\n41\t        ),\n42\t    }\n43\t}\n44\t\n45\tasync fn start_postgres() -> (ContainerAsync<Postgres>, String) {\n46\t    let container: ContainerAsync<Postgres> = Postgres::default()\n47\t        .with_tag(\"16-alpine\")\n48\t        .start()\n49\t        .await\n50\t        .expect(\"postgres container start\");\n51\t    let port = container\n52\t        .get_host_port_ipv4(5432)\n53\t        .await\n54\t        .expect(\"postgres port\");\n55\t    let url = format!(\"REDACTED\");\n56\t    (container, url)\n57\t}\n58\t\n59\t/// Seed `rows` rows so a streaming read spans several pages.\n60\tasync fn seed(url: &str, rows: i64) {\n61\t    let pool = sqlx::PgPool::connect(url).await.expect(\"pool\");\n62\t    sqlx::query(\"CREATE TABLE big (id BIGINT PRIMARY KEY, payload TEXT)\")\n63\t        .execute(&pool)\n64\t        .await\n65\t        .expect(\"create\");\n66\t    sqlx::query(\n67\t        \"INSERT INTO big (id, payload) \\\n68\t         SELECT g, repeat('x', 200) FROM generate_series(1, $1) AS g\",\n69\t    )\n70\t    .bind(rows)\n71\t    .execute(&pool)\n72\t    .await\n73\t    .expect(\"seed\");\n74\t    pool.close().await;\n75\t}\n76\t\n77\tasync fn source(url: &str, batch: usize) -> PostgresSource {\n78\t    PostgresSource::new(\n79\t        PostgresSourceConfig::new(url, \"SELECT id, payload FROM big ORDER BY id\")\n80\t            .with_batch_size(batch),\n81\t    )\n82\t    .await\n83\t    .expect(\"source\")\n84\t}\n85\t\n86\t#[tokio::test]\n87\tasync fn a_connection_cut_mid_stream_fails_the_run_and_terminates() {\n88\t    let (container, url) = start_postgres().await;\n89\t    seed(&url, 40_000).await;\n90\t\n91\t    let src = source(&url, 100).await;\n92\t    let sink = TestSink::new();\n93\t\n94\t    // Stop the server shortly after the read starts, while a cursor is open.\n95\t    let killer = tokio::spawn(async move {\n96\t        tokio::time::sleep(Duration::from_millis(400)).await;\n97\t        container.stop().await.expect(\"stop the container\");\n98\t        // Keep the handle alive until here so the container is not dropped (and\n99\t        // removed) before we mean to stop it.\n100\t        container\n101\t    });\n102\t\n103\t    let outcome = within(\n104\t        \"connection cut mid-stream\",\n105\t        Pipeline::new(&src, &sink).run(),\n106\t    )\n107\t    .await;\n108\t    let _ = killer.await;\n109\t\n110\t    let err = match outcome {\n111\t        Err(e) => e,\n112\t        Ok(result) => panic!(\n113\t            \"the run reported SUCCESS after its connection was cut, having written {} of \\\n114\t             40000 rows — a truncated dataset presented as complete is the worst outcome \\\n115\t             available here\",\n116\t            result.records_written\n117\t        ),\n118\t    };\n119\t\n120\t    // Typed, and attributed to the source — not a bare string a caller would\n121\t    // have to grep, and not a panic.\n122\t    assert!(\n123\t        matches!(\n124\t            err,\n125\t            faucet_core::FaucetError::Source(_) | faucet_core::FaucetError::Custom(_)\n126\t        ),\n127\t        \"a dead connection must surface as a typed source failure, got {err:?}\"\n128\t    );\n129\t\n130\t    // Whatever it wrote is a prefix of the data, never more than the source had.\n131\t    let written = sink.len();\n132\t    assert!(\n133\t        written < 40_000,\n134\t        \"the read was supposed to be cut short, but {written} rows arrived\"\n135\t    );\n136\t}\n137\t\n138\t#[tokio::test]\n139\tasync fn a_cut_before_the_first_page_fails_cleanly_rather_than_hanging() {\n140\t    // The connect-time variant: the server is already gone when the pipeline\n141\t    // starts. A driver configured with an unbounded connect retry would hang\n142\t    // here, which is the failure mode the ceiling catches.\n143\t    let (container, url) = start_postgres().await;\n144\t    seed(&url, 100).await;\n145\t    container.stop().await.expect(\"stop the container\");\n146\t\n147\t    let src = source(&url, 10).await;\n148\t    let sink = TestSink::new();\n149\t\n150\t    let err = within(\n151\t        \"connect against a stopped server\",\n152\t        Pipeline::new(&src, &sink).run(),\n153\t    )\n154\t    .await\n155\t    .expect_err(\"connecting to a stopped server must fail\");\n156\t\n157\t    assert!(\n158\t        !matches!(err, faucet_core::FaucetError::Config(_)),\n159\t        \"an unreachable server is a runtime failure, not a config one: {err:?}\"\n160\t    );\n161\t    assert!(\n162\t        sink.is_empty(),\n163\t        \"nothing may be written when the source never connected\"\n164\t    );\n165\t}\n166\t\n167\t#[tokio::test]\n168\tasync fn the_healthy_path_is_the_control_and_reads_every_row() {\n169\t    // Without this, a bug that made every run fail early would leave both tests\n170\t    // above passing for entirely the wrong reason.\n171\t    let (_c, url) = start_postgres().await;\n172\t    seed(&url, 2_500).await;\n173\t\n174\t    let src = source(&url, 100).await;\n175\t    let sink = TestSink::new();\n176\t\n177\t    let result = within(\"healthy control run\", Pipeline::new(&src, &sink).run())\n178\t        .await\n179\t        .expect(\"a healthy run completes\");\n180\t\n181\t    assert_eq!(\n182\t        result.records_written, 2_500,\n183\t        \"the control must read the whole table, or the cut-short assertions above \\\n184\t         are not measuring anything\"\n185\t    );\n186\t    assert_eq!(sink.len(), 2_500);\n187\t}\n188\t\n189\t#[tokio::test]\n190\tasync fn a_cut_connection_never_reports_a_bookmark_it_cannot_back() {\n191\t    // The durability tie-in: an incremental read that dies mid-stream must not\n192\t    // hand back a bookmark covering rows the sink never confirmed. The engine\n193\t    // tier asserts this with a scripted source; here the failure is a real\n194\t    // socket death partway through a real cursor.\n195\t    let (container, url) = start_postgres().await;\n196\t    seed(&url, 40_000).await;\n197\t\n198\t    let src = source(&url, 100).await;\n199\t    let sink = TestSink::new();\n200\t\n201\t    let killer = tokio::spawn(async move {\n202\t        tokio::time::sleep(Duration::from_millis(400)).await;\n203\t        container.stop().await.expect(\"stop\");\n204\t        container\n205\t    });\n206\t\n\n... [50 lines truncated] ...\n</system-reminder>"}],"session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.267","gitBranch":"fix/reliability-job-always-runs","slug":"linear-noodling-leaf"}
