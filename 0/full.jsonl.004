ull_bookmark() {\n56\t    // The distinction matters: `Some(Value::Null)` would be handed to\n57\t    // `apply_start_bookmark` as if it were a real position.\n58\t    let (bookmark, seq) = unwrap_state(&fixture(\"eo-envelope-null-bookmark-v1.json\"));\n59\t    assert_eq!(seq, 0);\n60\t    assert!(\n61\t        bookmark.is_none(),\n62\t        \"a null bookmark must unwrap to None, got {bookmark:?}\"\n63\t    );\n64\t}\n65\t\n66\t#[test]\n67\tfn a_bare_at_least_once_bookmark_is_still_read_as_a_bookmark() {\n68\t    // Every pipeline that predates exactly-once wrote a bare bookmark. Reading\n69\t    // it as an envelope (and so as `None`) would restart it from scratch.\n70\t    let stored = fixture(\"bare-bookmark-v1.json\");\n71\t    let (bookmark, seq) = unwrap_state(&stored);\n72\t    assert_eq!(seq, 0, \"a bare bookmark carries no sequence\");\n73\t    let bookmark = bookmark.expect(\"a bare bookmark must be returned as the bookmark\");\n74\t    assert_eq!(bookmark[\"updated_at\"], \"2026-05-01T00:00:00Z\");\n75\t    assert_eq!(\n76\t        bookmark[\"id\"].as_i64(),\n77\t        Some(9_007_199_254_740_993),\n78\t        \"an id past 2^53 must survive exactly — losing a digit silently re-reads or \\\n79\t         skips rows\"\n80\t    );\n81\t}\n82\t\n83\t#[test]\n84\tfn a_scalar_bookmark_survives_unchanged() {\n85\t    let stored = fixture(\"bare-bookmark-scalar-v1.json\");\n86\t    let (bookmark, seq) = unwrap_state(&stored);\n87\t    assert_eq!(seq, 0);\n88\t    assert_eq!(bookmark, Some(Value::String(\"2026-05-01T00:00:00Z\".into())));\n89\t}\n90\t\n91\t#[test]\n92\tfn commit_tokens_written_by_a_release_still_parse() {\n93\t    let tokens = fixture(\"commit-tokens-v1.json\");\n94\t\n95\t    assert_eq!(\n96\t        parse_token(tokens[\"bare\"].as_str().expect(\"string\")),\n97\t        Some(42),\n98\t        \"a stored bare token must still yield its sequence\"\n99\t    );\n100\t    assert_eq!(\n101\t        parse_token(tokens[\"zero\"].as_str().expect(\"string\")),\n102\t        Some(0)\n103\t    );\n104\t    assert_eq!(\n105\t        parse_token(tokens[\"max\"].as_str().expect(\"string\")),\n106\t        Some(u64::MAX),\n107\t        \"the widest sequence a u64 can hold must round-trip\"\n108\t    );\n109\t\n110\t    let (seq, bookmark) = parse_token_parts(tokens[\"with_bookmark\"].as_str().expect(\"string\"))\n111\t        .expect(\"a bookmark-carrying token must parse\");\n112\t    assert_eq!(seq, 42);\n113\t    assert_eq!(\n114\t        bookmark.expect(\"the token carries a bookmark\")[\"page\"],\n115\t        7,\n116\t        \"the embedded bookmark is what re-anchors the source on resume\"\n117\t    );\n118\t}\n119\t\n120\t#[test]\n121\tfn the_token_encoding_is_still_fixed_width_and_lexicographically_ordered() {\n122\t    // Sinks compare tokens as strings (a SQL `MAX(token)`, a compacted Kafka\n123\t    // key), so the encoding must sort the same way the numbers do. A change to\n124\t    // the width would silently invert that ordering for existing data.\n125\t    let stored = fixture(\"commit-tokens-v1.json\");\n126\t    let width = stored[\"bare\"].as_str().expect(\"string\").len();\n127\t    assert_eq!(\n128\t        format_token(42).len(),\n129\t        width,\n130\t        \"the token width changed — every stored token now sorts against the new ones \\\n131\t         incorrectly\"\n132\t    );\n133\t    assert_eq!(format_token(42), stored[\"bare\"].as_str().expect(\"string\"));\n134\t    assert_eq!(format_token(0), stored[\"zero\"].as_str().expect(\"string\"));\n135\t    assert_eq!(\n136\t        format_token(u64::MAX),\n137\t        stored[\"max\"].as_str().expect(\"string\")\n138\t    );\n139\t\n140\t    // The ordering property itself.\n141\t    let mut rendered: Vec<String> = [0u64, 1, 9, 10, 99, 100, u64::MAX]\n142\t        .iter()\n143\t        .map(|n| format_token(*n))\n144\t        .collect();\n145\t    let numeric_order = rendered.clone();\n146\t    rendered.sort();\n147\t    assert_eq!(\n148\t        rendered, numeric_order,\n149\t        \"fixed-width tokens must sort lexicographically in numeric order\"\n150\t    );\n151\t}\n152\t\n153\t#[test]\n154\tfn the_bookmark_carrying_token_separator_is_unchanged() {\n155\t    let stored = fixture(\"commit-tokens-v1.json\");\n156\t    let expected = stored[\"with_bookmark\"].as_str().expect(\"string\");\n157\t    let rendered = format_token_with_bookmark(42, Some(&serde_json::json!({ \"page\": 7 })));\n158\t    assert_eq!(\n159\t        rendered, expected,\n160\t        \"the separator or the embedded-bookmark rendering changed, so tokens written by \\\n161\t         a release can no longer be parsed back into a resume position\"\n162\t    );\n163\t}\n164\t\n165\t#[test]\n166\tfn garbage_is_rejected_rather_than_silently_read_as_zero() {\n167\t    // Reading an unparseable token as sequence 0 would make the engine believe\n168\t    // nothing had committed and replay the entire stream.\n169\t    for bad in [\n170\t        \"\",\n171\t        \"abc\",\n172\t        \"#\",\n173\t        \"#{}\",\n174\t        \"not-a-number#{\\\"page\\\":1}\",\n175\t        \"4 2\",\n176\t        \"42x\",\n177\t    ] {\n178\t        assert_eq!(\n179\t            parse_token(bad),\n180\t            None,\n181\t            \"{bad:?} must not parse as a valid sequence\"\n182\t        );\n183\t    }\n184\t}\n185\t\n186\t#[test]\n187\tfn a_whitespace_padded_token_still_parses_because_char_columns_pad() {\n188\t    // Deliberate, and load-bearing: the watermark table's token column may be\n189\t    // a fixed-width `CHAR(20)`, which pads on read. Rejecting the padded form\n190\t    // would make every stored watermark on such a column unreadable — the\n191\t    // engine would see \"nothing committed\" and replay the whole stream.\n192\t    //\n193\t    // Pinned here so the leniency is understood as a compatibility requirement\n194\t    // rather than mistaken for sloppiness and \"tidied up\" later.\n195\t    assert_eq!(parse_token(\"  00000000000000000042  \"), Some(42));\n196\t    assert_eq!(parse_token(\" 42\"), Some(42));\n197\t\n198\t    let (seq, bookmark) = parse_token_parts(\" 00000000000000000042 #{\\\"page\\\":7}\")\n199\t        .expect(\"a padded bookmark-carrying token must parse too\");\n\n... [52 lines truncated] ...\n</system-reminder>"}],"session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.267","gitBranch":"test/reliability-program","slug":"linear-noodling-leaf"}
