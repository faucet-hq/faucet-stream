\n155\t    let store = Arc::new(sink.state_store());\n156\t\n157\t    let first = PagedSource::new(4, 3);\n158\t    Pipeline::new(&first, &sink)\n159\t        .with_state_store(store.clone())\n160\t        .with_delivery(DeliveryMode::ExactlyOnce)\n161\t        .run()\n162\t        .await\n163\t        .expect(\"first run\");\n164\t    let after_first = log.records_written();\n165\t    assert_eq!(after_first, 12);\n166\t\n167\t    let second = PagedSource::new(4, 3);\n168\t    let result = Pipeline::new(&second, &sink)\n169\t        .with_state_store(store.clone())\n170\t        .with_delivery(DeliveryMode::ExactlyOnce)\n171\t        .run()\n172\t        .await\n173\t        .expect(\"second run\");\n174\t\n175\t    assert_eq!(\n176\t        log.records_written(),\n177\t        after_first,\n178\t        \"a re-run of a completed exactly-once pipeline wrote {} extra records\",\n179\t        log.records_written() - after_first\n180\t    );\n181\t    assert_eq!(result.records_written, 0);\n182\t}\n183\t\n184\t#[tokio::test]\n185\tasync fn the_keyed_upsert_mechanism_converges_without_any_watermark() {\n186\t    // The second mechanism. No commit token is involved: the sink dedups by\n187\t    // key, so replaying the full window must leave the destination identical.\n188\t    let log = EventLog::new();\n189\t    let sink = ScriptedSink::new(log.clone()).keyed();\n190\t    assert!(\n191\t        !sink.supports_idempotent_writes(),\n192\t        \"this arm must exercise the keyed path, not the watermark path\"\n193\t    );\n194\t    assert!(sink.dedups_by_key());\n195\t\n196\t    let store = Arc::new(sink.state_store());\n197\t    let source = PagedSource::new(3, 5);\n198\t    Pipeline::new(&source, &sink)\n199\t        .with_state_store(store.clone())\n200\t        .with_delivery(DeliveryMode::ExactlyOnce)\n201\t        .run()\n202\t        .await\n203\t        .expect(\"keyed exactly-once run succeeds\");\n204\t\n205\t    // Replay the same window from scratch against 