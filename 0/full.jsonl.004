.unwrap_or(Value::String(t)),\n149\t            },\n150\t        );\n151\t    }\n152\t    pool.close().await;\n153\t    let landed = Value::Object(landed_obj);\n154\t\n155\t    // Three allowances, each a real SQLite limitation rather than a pipeline\n156\t    // defect — which is exactly what `Tolerance` exists to make explicit:\n157\t    //\n158\t    //  * `lenient_scalar_kind` — the columns here are declared TEXT, so every\n159\t    //    scalar comes back as text. The *value* must still match.\n160\t    //  * the two boolean columns — SQLite has no boolean type at all; `true` and\n161\t    //    `false` are stored as `1` and `0`, so neither the kind nor the\n162\t    //    rendering survives. Anything reading these columns back must know that,\n163\t    //    which is why it is named here rather than smoothed over.\n164\t    //  * `floats_negative_zero` — the sign bit of negative zero does not survive\n165\t    //    the trip through a TEXT-affinity column.\n166\t    //\n167\t    // Nothing else is tolerated: the i64-past-2^53, unicode, embedded quotes and\n168\t    // backslashes, empty strings, timestamps with offsets, pre-epoch instants and\n169\t    // nested JSON all have to land exactly.\n170\t    fidelity::assert_round_trip(\n171\t        std::slice::from_ref(&flat),\n172\t        std::slice::from_ref(&landed),\n173\t        Tolerance::exact()\n174\t            .lenient_scalar_kind()\n175\t            .skipping(\"booleans_and_null_true_val\")\n176\t            .skipping(\"booleans_and_null_false_val\")\n177\t            .skipping(\"floats_negative_zero\"),\n178\t    );\n179\t\n180\t    // The skipped columns are skipped because of a *known* behaviour, so pin\n181\t    // that behaviour too — otherwise a future change could start dropping the\n182\t    // column entirely and this test would still pass.\n183\t    assert_eq!(\n184\t        landed[\"booleans_and_null_true_val\"],\n185\t        json!(1),\n186\t        \"SQLite stores a true as 1; if that changes, the tolerance above is stale\"\n187\t    );\n188\t    assert_eq!(landed[\"booleans_and_null_false_val\"], json!(0));\n189\t    assert!(\n\n... [38 lines truncated] ...\n</system-reminder>"}],"session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.267","gitBranch":"test/reliability-program","slug":"linear-noodling-leaf"}
