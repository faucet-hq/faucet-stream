1\t        log.events()\n62\t    );\n63\t    let t = tokens(&log);\n64\t    assert_eq!(t.len(), 3, \"one commit token per page: {t:?}\");\n65\t\n66\t    // Tokens must be strictly increasing, since the resume logic compares them\n67\t    // ordinally to decide what has already landed.\n68\t    let mut sorted = t.clone();\n69\t    sorted.sort();\n70\t    assert_eq!(t, sorted, \"commit tokens must be monotonic: {t:?}\");\n71\t    assert_eq!(\n72\t        t.iter().collect::<std::collections::BTreeSet<_>>().len(),\n73\t        t.len(),\n74\t        \"commit tokens must be distinct: {t:?}\"\n75\t    );\n76\t\n77\t    assert_bookmarks_backed_by_writes(&log, |b| {\n78\t        let bare = faucet_core::idempotency::unwrap_state(b)\n79\t            .0\n80\t            .unwrap_or(b.clone());\n81\t        records_through_page(bare[\"page\"].as_u64().expect(\"page\") as usize, 4)\n82\t    });\n83\t}\n84\t\n85\t#[tokio::test]\n86\tasync fn a_crash_between_sink_commit_and_state_put_replays_nothing() {\n87\t    // The exactly-once window. Run 1's second bookmark `put` fails *after* the\n88\t    // sink has durably committed page 1 and its token. The sink is therefore\n89\t    // ahead of the state store.\n90\t    let per_page = 4;\n91\t    let log = EventLog::new();\n92\t    let sink = ScriptedSink::new(log.clone()).idempotent();\n93\t    let store = Arc::new(sink.state_store());\n94\t\n95\t    let source1 = PagedSource::new(5, per_page);\n96\t    let _ = Pipeline::new(&source1, &sink)\n97\t        .with_state_store(store.clone())\n98\t        .with_delivery(DeliveryMode::ExactlyOnce)\n99\t        .run()\n100\t        .await;\n101\t\n102\t    assert!(\n103\t        log.any(|e| matches!(e, Event::IdempotentWrite { .. })),\n104\t        \"run 1 must have committed at least one page: {:?}\",\n105\t        log.events()\n106\t    );\n107\t    let committed_run1 = log.records_written();\n108\t    let token_after_run1 = sink\n109\t        .last_committed_token(\"scripted:paged\")\n110\t  