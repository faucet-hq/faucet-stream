{"parentUuid":"ce329d09-a094-495e-ab0e-8de01780be64","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_01HS7pSMMdoDxMTHDLosGGqy","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"55398c64-7c65-40db-9b68-886111a86d7f\\\",\\\"cwd\\\":\\\"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream\\\",\\\"project\\\":\\\"faucet-stream\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/c-sikawats/.claude/plugins/cache/claude-code-warp/warp/2.2.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":320},"type":"attachment","uuid":"719149b7-accb-466b-9737-07b8154dd8d2","timestamp":"2026-09-18T04:53:39.290Z","session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.267","gitBranch":"fix/reliability-job-always-runs","slug":"linear-noodling-leaf"}
{"parentUuid":"719149b7-accb-466b-9737-07b8154dd8d2","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream/crates/sink/sqlite/tests/drift_policy_matrix.rs","snippet":"1\t//! #651 Category A6 — the schema-drift policy matrix, end to end.\n2\t//!\n3\t//! `faucet_core::drift` unit-tests the *classification* (which columns are\n4\t//! additions, widenings, incompatible) and each sink unit-tests its own\n5\t//! `evolve_schema`. Neither covers the thing an operator actually configures:\n6\t//! **what the pipeline does** under each `on_drift` policy when a real source\n7\t//! starts sending a column a real destination does not have.\n8\t//!\n9\t//! That is a five-way behavioural fork — warn / evolve / ignore / quarantine /\n10\t//! fail — and every arm has a different, and silent, wrong answer:\n11\t//!\n12\t//! | Policy | The wrong answer nobody would notice |\n13\t//! |---|---|\n14\t//! | `warn` | dropping the page instead of writing it |\n15\t//! | `evolve` | writing without the DDL, so the new column is lost |\n16\t//! | `ignore` | failing the run, or writing the unknown column and erroring |\n17\t//! | `quarantine` | writing the drifting rows anyway |\n18\t//! | `fail` | writing the page and *then* raising |\n19\t//!\n20\t//! SQLite is the destination because it needs no container, so this matrix runs\n21\t//! in the required CI tier. It is add-column-only under dynamic typing, which\n22\t//! is exactly the shape the additive path needs.\n23\t\n24\tuse std::sync::Arc;\n25\t\n26\tuse faucet_core::drift::{OnDrift, SchemaDriftPolicy, SchemaDriftSpec};\n27\tuse faucet_core::{DlqConfig, OnBatchError, Pipeline, Source, StreamPage, Value, async_trait, json};\n28\tuse faucet_sink_sqlite::{SqliteColumnMapping, SqliteSink, SqliteSinkConfig};\n29\tuse sqlx::Row;\n30\tuse sqlx::sqlite::SqlitePoolOptions;\n31\tuse tempfile::TempDir;\n32\t\n33\t/// A source emitting one page whose records carry `extra` — a column the\n34\t/// destination table does not declare.\n35\tstruct DriftingSource {\n36\t    records: Vec<Value>,\n37\t}\n38\t\n39\t#[async_trait]\n40\timpl Source for DriftingSource {\n41\t    async fn fetch_with_context(\n42\t        &self,\n43\t        _ctx: &std::collections::HashMap<String, Value>,\n44\t    ) -> Result<Vec<Value>, faucet_core::FaucetError> {\n45\t        Ok(self.records.clone())\n46\t    }\n47\t\n48\t    fn stream_pages<'a>(\n49\t        &'a self,\n50\t        _ctx: &'a std::collections::HashMap<String, Value>,\n51\t        _batch: usize,\n52\t    ) -> std::pin::Pin<\n53\t        Box<\n54\t            dyn futures::Stream<Item = Result<StreamPage, faucet_core::FaucetError>>\n55\t                + Send\n56\t                + 'a,\n57\t        >,\n58\t    > {\n59\t        let records = self.records.clone();\n60\t        Box::pin(async_stream::try_stream! {\n61\t            yield StreamPage { records, bookmark: None };\n62\t        })\n63\t    }\n64\t\n65\t    fn config_schema(&self) -> Value {\n66\t        json!({ \"type\": \"object\" })\n67\t    }\n68\t\n69\t    fn connector_name(&self) -> &'static str {\n70\t        \"drifting\"\n71\t    }\n72\t}\n73\t\n74\tasync fn fresh_db(create_sql: &str) -> (TempDir, String) {\n75\t    let dir = TempDir::new().expect(\"tempdir\");\n76\t    let path = dir.path().join(\"drift.db\");\n77\t    let url = format!(\"sqlite://{}?mode=rwc\", path.display());\n78\t    let pool = SqlitePoolOptions::new()\n79\t        .max_connections(1)\n80\t        .connect(&url)\n81\t        .await\n82\t        .expect(\"connect\");\n83\t    sqlx::query(create_sql)\n84\t        .execute(&pool)\n85\t        .await\n86\t        .expect(\"create table\");\n87\t    pool.close().await;\n88\t    (dir, url)\n89\t}\n90\t\n91\tasync fn column_names(url: &str, table: &str) -> Vec<String> {\n92\t    let pool = SqlitePoolOptions::new()\n93\t        .max_connections(1)\n94\t        .connect(url)\n95\t        .await\n96\t        .expect(\"connect\");\n97\t    let rows = sqlx::query(&format!(\"PRAGMA table_info(\\\"{table}\\\")\"))\n98\t        .fetch_all(&pool)\n99\t        .await\n100\t        .expect(\"pragma\");\n101\t    pool.close().await;\n102\t    rows.iter()\n103\t        .map(|r| r.try_get::<String, _>(\"name\").expect(\"name\"))\n104\t        .collect()\n105\t}\n106\t\n107\tasync fn row_count(url: &str, table: &str) -> i64 {\n108\t    let pool = SqlitePoolOptions::new()\n109\t        .max_connections(1)\n110\t        .connect(url)\n111\t        .await\n112\t        .expect(\"connect\");\n113\t    let n: i64 = sqlx::query(&format!(\"SELECT COUNT(*) FROM \\\"{table}\\\"\"))\n114\t        .fetch_one(&pool)\n115\t        .await\n116\t        .expect(\"count\")\n117\t        .try_get(0)\n118\t        .expect(\"scalar\");\n119\t    pool.close().await;\n120\t    n\n121\t}\n122\t\n123\t/// The destination knows `id` and `name`; the source also sends `extra`.\n124\tasync fn setup() -> (TempDir, String, SqliteSink, DriftingSource) {\n125\t    let (dir, url) = fresh_db(\"CREATE TABLE events (id INTEGER, name TEXT)\").await;\n126\t    let sink = SqliteSink::new(\n127\t        SqliteSinkConfig::new(&url, \"events\").column_mapping(SqliteColumnMapping::AutoMap),\n128\t    )\n129\t    .await\n130\t    .expect(\"sink\");\n131\t    let source = DriftingSource {\n132\t        records: vec![\n133\t            json!({ \"id\": 1, \"name\": \"a\", \"extra\": \"drifted\" }),\n134\t            json!({ \"id\": 2, \"name\": \"b\", \"extra\": \"drifted too\" }),\n135\t        ],\n136\t    };\n137\t    (dir, url, sink, source)\n138\t}\n139\t\n140\tfn policy(on_drift: OnDrift) -> SchemaDriftPolicy {\n141\t    SchemaDriftPolicy::compile(&SchemaDriftSpec {\n142\t        on_drift,\n143\t        allow_type_widening: true,\n144\t        on_incompatible: faucet_core::drift::OnIncompatible::Fail,\n145\t        relax_nullability_on_missing: false,\n146\t    })\n147\t}\n148\t\n149\t/// A DLQ writing to a JSONL file, for the quarantine arm.\n150\tfn dlq(dir: &std::path::Path) -> (DlqConfig, std::path::PathBuf) {\n151\t    let path = dir.join(\"dlq.jsonl\");\n152\t    (\n153\t        DlqConfig {\n154\t            sink: Arc::new(faucet_sink_jsonl::JsonlSink::new(\n155\t                faucet_sink_jsonl::JsonlSinkConfig::new(&path),\n156\t            )),\n157\t            on_batch_error: OnBatchError::Propagate,\n158\t            max_failures_per_page: None,\n159\t            max_failures_total: None,\n160\t            include_original_payload: true,\n161\t        },\n162\t        path,\n163\t    )\n164\t}\n165\t\n166\t#[tokio::test]\n167\tasync fn warn_writes_the_page_unchanged_and_does_not_evolve() {\n168\t    let (_dir, url, sink, source) = setup().await;\n169\t\n170\t    let result = Pipeline::new(&source, &sink)\n171\t        .with_schema_drift(policy(OnDrift::Warn))\n172\t        .run()\n173\t        .await\n174\t        .expect(\"warn must not fail the run\");\n175\t\n176\t    assert_eq!(result.records_written, 2, \"warn writes the page unchanged\");\n177\t    assert_eq!(row_count(&url, \"events\").await, 2);\n178\t    assert!(\n179\t        !column_names(&url, \"events\").await.contains(&\"extra\".into()),\n180\t        \"warn must not apply DDL — that is `evolve`'s job\"\n181\t    );\n182\t}\n183\t\n184\t#[tokio::test]\n185\tasync fn evolve_applies_the_ddl_before_writing_so_the_new_column_lands() {\n186\t    let (_dir, url, sink, source) = setup().await;\n187\t\n188\t    let result = Pipeline::new(&source, &sink)\n189\t        .with_schema_drift(policy(OnDrift::Evolve))\n190\t        .run()\n191\t        .await\n192\t        .expect(\"evolve must succeed on a purely additive change\");\n193\t\n194\t    assert_eq!(result.records_written, 2);\n195\t    let cols = column_names(&url, \"events\").await;\n196\t    assert!(\n197\t        cols.contains(&\"extra\".into()),\n198\t        \"evolve must add the drifted column: {cols:?}\"\n199\t    );\n200\t\n201\t    // And the value must actually be in it — DDL without the data would be the\n202\t    // silent half-failure this arm exists to prevent.\n203\t    let pool = SqlitePoolOptions::new()\n204\t        .max_connections(1)\n205\t        .connect(&url)\n206\t        .await\n207\t        .expect(\"connect\");\n208\t    let got: Option<String> = sqlx::query(\"SELECT extra FROM events WHERE id = 1\")\n209\t        .fetch_one(&pool)\n210\t        .await\n211\t        .expect(\"row\")\n212\t        .try_get(0)\n213\t        .expect(\"column\");\n214\t    pool.close().await;\n215\t    assert_eq!(\n216\t        got.as_deref(),\n217\t        Some(\"drifted\"),\n218\t        \"the evolved column must hold the page's value, not NULL\"\n219\t    );\n220\t}\n221\t\n222\t#[tokio::test]\n223\tasync fn ignore_drops_the_unknown_field_and_still_writes_the_rest() {\n224\t    let (_dir, url, sink, source) = setup().await;\n225\t\n226\t    let result = Pipeline::new(&source, &sink)\n\n... [135 lines truncated] ..."},"type":"attachment","uuid":"b8630fc3-b301-4e98-9c1f-01a7e1f35c88","timestamp":"2026-09-18T04:53:39.322Z","rendered":[{"content":"<system-reminder>\nNote: /Users/c-sikawats/Documents/GitHub/Personal/faucet-stream/crates/sink/sqlite/tests/drift_policy_matrix.rs changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n1\t//! #651 Category A6 — the schema-drift policy matrix, end to end.\n2\t//!\n3\t//! `faucet_core::drift` unit-tests the *classification* (which columns are\n4\t//! additions, widenings, incompatible) and each sink unit-tests its own\n5\t//! `evolve_schema`. Neither covers the thing an operator actually configures:\n6\t//! **what the pipeline does** under each `on_drift` policy when a real source\n7\t//! starts sending a column a real destination does not have.\n8\t//!\n9\t//! That is a five-way behavioural fork — warn / evolve / ignore / quarantine /\n10\t//! fail — and every arm has a different, and silent, wrong answer:\n11\t//!\n12\t//! | Policy | The wrong answer nobody would notice |\n13\t//! |---|---|\n14\t//! | `warn` | dropping the page instead of writing it |\n15\t//! | `evolve` | writing without the DDL, so the new column is lost |\n16\t//! | `ignore` | failing the run, or writing the unknown column and erroring |\n17\t//! | `quarantine` | writing the drifting rows anyway |\n18\t//! | `fail` | writing the page and *then* raising |\n19\t//!\n20\t//! SQLite is the destination because it needs no container, so this matrix runs\n21\t//! in the required CI tier. It is add-column-only under dynamic typing, which\n22\t//! is exactly the shape the additive path needs.\n23\t\n24\tuse std::sync::Arc;\n25\t\n26\tuse faucet_core::drift::{OnDrift, SchemaDriftPolicy, SchemaDriftSpec};\n27\tuse faucet_core::{DlqConfig, OnBatchError, Pipeline, Source, StreamPage, Value, async_trait, json};\n28\tuse faucet_sink_sqlite::{SqliteColumnMapping, SqliteSink, SqliteSinkConfig};\n29\tuse sqlx::Row;\n30\tuse sqlx::sqlite::SqlitePoolOptions;\n31\tuse tempfile::TempDir;\n32\t\n33\t/// A source emitting one page whose records carry `extra` — a column the\n34\t/// destination table does not declare.\n35\tstruct DriftingSource {\n36\t    records: Vec<Value>,\n37\t}\n38\t\n39\t#[async_trait]\n40\timpl Source for DriftingSource {\n41\t    async fn fetch_with_context(\n42\t        &self,\n43\t        _ctx: &std::collections::HashMap<String, Value>,\n44\t    ) -> Result<Vec<Value>, faucet_core::FaucetError> {\n45\t        Ok(self.records.clone())\n46\t    }\n47\t\n48\t    fn stream_pages<'a>(\n49\t        &'a self,\n50\t        _ctx: &'a std::collections::HashMap<String, Value>,\n51\t        _batch: usize,\n52\t    ) -> std::pin::Pin<\n53\t        Box<\n54\t            dyn futures::Stream<Item = Result<StreamPage, faucet_core::FaucetError>>\n55\t                + Send\n56\t                + 'a,\n57\t        >,\n58\t    > {\n59\t        let records = self.records.clone();\n60\t        Box::pin(async_stream::try_stream! {\n61\t            yield StreamPage { records, bookmark: None };\n62\t        })\n63\t    }\n64\t\n65\t    fn config_schema(&self) -> Value {\n66\t        json!({ \"type\": \"object\" })\n67\t    }\n68\t\n69\t    fn connector_name(&self) -> &'static str {\n70\t        \"drifting\"\n71\t    }\n72\t}\n73\t\n74\tasync fn fresh_db(create_sql: &str) -> (TempDir, String) {\n75\t    let dir = TempDir::new().expect(\"tempdir\");\n76\t    let path = dir.path().join(\"drift.db\");\n77\t    let url = format!(\"sqlite://{}?mode=rwc\", path.display());\n78\t    let pool = SqlitePoolOptions::new()\n79\t        .max_connections(1)\n80\t        .connect(&url)\n81\t        .await\n82\t        .expect(\"connect\");\n83\t    sqlx::query(create_sql)\n84\t        .execute(&pool)\n85\t        .await\n86\t        .expect(\"create table\");\n87\t    pool.close().await;\n88\t    (dir, url)\n89\t}\n90\t\n91\tasync fn column_names(url: &str, table: &str) -> Vec<String> {\n92\t    let pool = SqlitePoolOptions::new()\n93\t        .max_connections(1)\n94\t        .connect(url)\n95\t        .await\n96\t        .expect(\"connect\");\n97\t    let rows = sqlx::query(&format!(\"PRAGMA table_info(\\\"{table}\\\")\"))\n98\t        .fetch_all(&pool)\n99\t        .await\n100\t        .expect(\"pragma\");\n101\t    pool.close().await;\n102\t    rows.iter()\n103\t        .map(|r| r.try_get::<String, _>(\"name\").expect(\"name\"))\n104\t        .collect()\n105\t}\n106\t\n107\tasync fn row_count(url: &str, table: &str) -> i64 {\n108\t    let pool = SqlitePoolOptions::new()\n109\t        .max_connections(1)\n110\t        .connect(url)\n111\t        .await\n112\t        .expect(\"connect\");\n113\t    let n: i64 = sqlx::query(&format!(\"SELECT COUNT(*) FROM \\\"{table}\\\"\"))\n114\t        .fetch_one(&pool)\n115\t        .await\n116\t        .expect(\"count\")\n117\t        .try_get(0)\n118\t        .expect(\"scalar\");\n119\t    pool.close().await;\n120\t    n\n121\t}\n122\t\n123\t/// The destination knows `id` and `name`; the source also sends `extra`.\n124\tasync fn setup() -> (TempDir, String, SqliteSink, DriftingSource) {\n125\t    let (dir, url) = fresh_db(\"CREATE TABLE events (id INTEGER, name TEXT)\").await;\n126\t    let sink = SqliteSink::new(\n127\t        SqliteSinkConfig::new(&url, \"events\").column_mapping(SqliteColumnMapping::AutoMap),\n128\t    )\n129\t    .await\n130\t    .expect(\"sink\");\n131\t    let source = DriftingSource {\n132\t        records: vec![\n133\t            json!({ \"id\": 1, \"name\": \"a\", \"extra\": \"drifted\" }),\n134\t            json!({ \"id\": 2, \"name\": \"b\", \"extra\": \"drifted too\" }),\n135\t        ],\n136\t    };\n137\t    (dir, url, sink, source)\n138\t}\n139\t\n140\tfn policy(on_drift: OnDrift) -> SchemaDriftPolicy {\n141\t    SchemaDriftPolicy::compile(&SchemaDriftSpec {\n142\t        on_drift,\n143\t        allow_type_widening: true,\n144\t        on_incompatible: faucet_core::drift::OnIncompatible::Fail,\n145\t        relax_nullability_on_missing: false,\n146\t    })\n147\t}\n148\t\n149\t/// A DLQ writing to a JSONL file, for the quarantine arm.\n150\tfn dlq(dir: &std::path::Path) -> (DlqConfig, std::path::PathBuf) {\n151\t    let path = dir.join(\"dlq.jsonl\");\n152\t    (\n153\t        DlqConfig {\n154\t            sink: Arc::new(faucet_sink_jsonl::JsonlSink::new(\n155\t                faucet_sink_jsonl::JsonlSinkConfig::new(&path),\n156\t            )),\n157\t            on_batch_error: OnBatchError::Propagate,\n158\t            max_failures_per_page: None,\n159\t            max_failures_total: None,\n160\t            include_original_payload: true,\n161\t        },\n162\t        path,\n163\t    )\n164\t}\n165\t\n166\t#[tokio::test]\n167\tasync fn warn_writes_the_page_unchanged_and_does_not_evolve() {\n168\t    let (_dir, url, sink, source) = setup().await;\n169\t\n170\t    let result = Pipeline::new(&source, &sink)\n171\t        .with_schema_drift(policy(OnDrift::Warn))\n172\t        .run()\n173\t        .await\n174\t        .expect(\"warn must not fail the run\");\n175\t\n176\t    assert_eq!(result.records_written, 2, \"warn writes the page unchanged\");\n177\t    assert_eq!(row_count(&url, \"events\").await, 2);\n178\t    assert!(\n179\t        !column_names(&url, \"events\").await.contains(&\"extra\".into()),\n180\t        \"warn must not apply DDL — that is `evolve`'s job\"\n181\t    );\n182\t}\n183\t\n184\t#[tokio::test]\n185\tasync fn evolve_applies_the_ddl_before_writing_so_the_new_column_lands() {\n186\t    let (_dir, url, sink, source) = setup().await;\n187\t\n188\t    let result = Pipeline::new(&source, &sink)\n189\t        .with_schema_drift(policy(OnDrift::Evolve))\n190\t        .run()\n191\t        .await\n192\t        .expect(\"evolve must succeed on a purely additive change\");\n193\t\n194\t    assert_eq!(result.records_written, 2);\n195\t    let cols = column_names(&url, \"events\").await;\n196\t    assert!(\n197\t        cols.contains(&\"extra\".into()),\n198\t        \"evolve must add the drifted column: {cols:?}\"\n199\t    );\n200\t\n201\t    // And the value must actually be in it — DDL without the data would be the\n202\t    // silent half-failure this arm exists to prevent.\n203\t    let pool = SqlitePoolOptions::new()\n204\t        .max_connections(1)\n205\t        .connect(&url)\n206\t        .await\n207\t        .expect(\"connect\");\n208\t    let got: Option<String> = sqlx::query(\"SELECT extra FROM events WHERE id = 1\")\n209\t        .fetch_one(&pool)\n210\t        .await\n211\t        .expect(\"row\")\n212\t        .try_get(0)\n213\t        .expect(\"column\");\n214\t    pool.close().await;\n215\t    assert_eq!(\n216\t        got.as_deref(),\n217\t        Some(\"drifted\"),\n218\t        \"the evolved column must hold the page's value, not NULL\"\n219\t    );\n220\t}\n221\t\n222\t#[tokio::test]\n223\tasync fn ignore_drops_the_unknown_field_and_still_writes_the_rest() {\n224\t    let (_dir, url, sink, source) = setup().await;\n225\t\n226\t    let result = Pipeline::new(&source, &sink)\n\n... [135 lines truncated] ...\n</system-reminder>"}],"session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.267","gitBranch":"fix/reliability-job-always-runs","slug":"linear-noodling-leaf"}
