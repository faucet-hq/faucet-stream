ss-paths: e8e4c78b test(http): pin both retry-wait arms (server Retry-After wins; otherwise never a hot loop)\nstash@{1}: On chore/decouple-internal-dep-versions: wip: bq overwrite fix + templates UI table (session)\n    pipeline_name: &'a str,\n    reported: &'a faucet_core::topology::TopologyRun,\n    state_store: Option<&'a std::sync::Arc<dyn faucet_core::StateStore>>,\n    identities: &'a NodeIdentities,\n    reaching: &'a std::collections::HashMap<String, Vec<String>>,\n    clock: DateTime<FixedOffset>,\n    run_id: &'a str,\n    #[cfg(feature = \"lineage\")]\n    lineage: Option<&'a std::sync::Arc<faucet_lineage::LineageEmitter>>,\n}\n\nasync fn post_run_observability(cfg: &PipelineConfig, ctx: PostRun<'_>) {\n    let PostRun {\n        pipeline_name,\n        reported,\n        state_store,\n        identities,\n        reaching,\n        clock,\n        run_id,\n        #[cfg(feature = \"lineage\")]\n        lineage,\n    } = ctx;\n    #[cfg(feature = \"catalog\")]\n    let catalog = match cfg.catalog.as_ref() {\n        Some(spec) => match crate::catalog::connect_from_spec(spec).await {\n            Ok(h) => Some(h),\n            Err(e) => {\n                // Recording is best-effort; a bad catalog URL must not retro-fail\n                // a run whose data is already written.\n                tracing::error!(error = %e, \"catalog connect failed; not recording\");","is_error":false}]},"uuid":"81101507-d9f0-4e70-b6e1-e523ff21d653","timestamp":"2026-09-18T10:16:36.689Z","toolUseResult":{"stdout":"cli/examples/csv_to_mysql.yaml\ncli/examples/csv_to_sqlite.yaml\ncli/examples/graphql_to_postgres.yaml\ncli/examples/mongodb_to_postgres.yaml\ncli/examples/mysql_to_postgres.yaml\ncli/examples/odata_to_jsonl.yaml\ncli/examples/redis_to_mysql.yaml\ncli/examples/redis_to_sqlite.yaml\ncli/examples/rest_async_job.yaml\ncli/examples/rest_decode_report.yaml\ncli/examples/rest_file_to_jsonl.yaml\ncli/examples/rest_to_jsonl_resilient.yaml\ncli/examples/rest_to_jsonl_templ