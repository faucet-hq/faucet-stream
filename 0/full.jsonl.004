\t        );\n151\t    }\n152\t    pool.close().await;\n153\t    let landed = Value::Object(landed_obj);\n154\t\n155\t    // Declared TEXT columns render every scalar as text, so the JSON *kind* is\n156\t    // not preserved — only the value. That is a property of the schema this\n157\t    // test created, not a pipeline defect, so it is stated rather than hidden.\n158\t    fidelity::assert_round_trip(\n159\t        std::slice::from_ref(&flat),\n160\t        std::slice::from_ref(&landed),\n161\t        Tolerance::exact().lenient_scalar_kind(),\n162\t    );\n163\t}\n164\t\n165\t#[tokio::test]\n166\tasync fn the_corpus_is_not_silently_empty() {\n167\t    // Guards both tests above: if `corpus()` ever returned nothing, they would\n168\t    // pass while asserting nothing at all.\n169\t    let sent = fidelity::corpus();\n170\t    assert!(sent.len() >= 6, \"the shared corpus lost its hazard classes\");\n171\t    assert!(\n172\t        sent.iter().all(|r| r.get(ROW_KEY).is_some()),\n173\t        \"every corpus row must be keyed so reordering destinations compare correctly\"\n174\t    );\n175\t    // And the value that motivated the whole exercise is present.\n176\t    assert!(\n177\t        sent.iter().any(|r| r\n178\t            .get(\"beyond_f64_exact\")\n179\t            .and_then(|v| v.as_i64())\n180\t            .is_some_and(|n| n > 9_007_199_254_740_992)),\n181\t        \"the corpus must still carry an integer past 2^53\"\n182\t    );\n183\t}\n184\t\n185\t#[tokio::test]\n186\tasync fn a_deliberately_corrupted_read_back_is_caught() {\n187\t    // The failing-first proof for this pair: if the comparison could not fail,\n188\t    // the two round-trip tests above would be decorative.\n189\t    let sent = fidelity::corpus();\n190\t    let mut landed = sent.clone();\n191\t    landed[0][\"i64_max\"] = json!(0);\n192\t\n193\t    let mismatches = fidelity::diff_round_trip(&sent, &landed, &Tolerance::exact());\n194\t    assert_eq!(mismatches.len(), 1, \"{mismatches:?}\");\n1