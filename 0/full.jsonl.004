     }),\n141\t        json!({\n142\t            ROW_KEY: \"booleans_and_null\",\n143\t            \"true_val\": true,\n144\t            \"false_val\": false,\n145\t            \"null_val\": Value::Null,\n146\t        }),\n147\t        json!({\n148\t            ROW_KEY: \"nested\",\n149\t            \"object\": { \"a\": 1, \"b\": { \"c\": [1, 2, 3] } },\n150\t            \"array\": [1, \"two\", null, true],\n151\t            \"empty_object\": {},\n152\t            \"empty_array\": [],\n153\t        }),\n154\t    ]\n155\t}\n156\t\n157\t/// The corpus as a flat single record, for destinations that take one wide row\n158\t/// rather than one row per hazard class. Field names are prefixed with the\n159\t/// class so they stay unique.\n160\tpub fn flat_corpus() -> Value {\n161\t    let mut out = serde_json::Map::new();\n162\t    out.insert(ROW_KEY.to_string(), json!(\"flat\"));\n163\t    for rec in corpus() {\n164\t        let Some(obj) = rec.as_object() else { continue };\n165\t        let Some(class) = obj.get(ROW_KEY).and_then(|v| v.as_str()) else {\n166\t            continue;\n167\t        };\n168\t        for (k, v) in obj {\n169\t            if k == ROW_KEY {\n170\t                continue;\n171\t            }\n172\t            out.insert(format!(\"{class}_{k}\"), v.clone());\n173\t        }\n174\t    }\n175\t    Value::Object(out)\n176\t}\n177\t\n178\t/// One field that did not survive the trip.\n179\t#[derive(Debug, Clone, PartialEq)]\n180\tpub struct Mismatch {\n181\t    /// [`ROW_KEY`] of the record.\n182\t    pub row: String,\n183\t    /// Field name, or `\"<row>\"` when the whole record is missing or extra.\n184\t    pub field: String,\n185\t    /// What was sent.\n186\t    pub sent: Value,\n187\t    /// What landed (`Null` when absent).\n188\t    pub landed: Value,\n189\t}\n190\t\n191\timpl std::fmt::Display for Mismatch {\n192\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n193\t        write!(\n194\t            f,\n195\t         