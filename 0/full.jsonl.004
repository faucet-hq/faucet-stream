and a JSON array isn't valid until its closing `]`). Because objects are fetched concurrently, peak memory is bounded by roughly **`concurrency` × (largest object's decoded size)**, not by `batch_size`. For large `raw_text` / `json_array` objects, lower `concurrency` to cap peak memory, or re-emit the data as `json_lines` upstream so it streams at `O(batch_size)`.\\n\" + PARQUET_NOTE),\n])\nPY","description":"Correct the README memory notes for parquet"}},"wireIngestContext":{"toolu_0158ue8Fo6Acj6fFhgGUoXcS":{"cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream"}},"apiBlockIndex":0,"requestId":"req_011CfAoPeJx88z6yniUEx9D3","type":"assistant","uuid":"4256948b-e1a6-45ae-b739-b0ecdf20a3f8","timestamp":"2026-09-18T11:09:24.275Z","effort":"high","perTurnEffort":null,"session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.267","gitBranch":"fix/inert-config-knobs","slug":"linear-noodling-leaf"}
