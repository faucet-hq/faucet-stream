        assert_eq!(backoff_delay(base, 1), Duration::from_secs(2));\n-        assert_eq!(backoff_delay(base, 3), Duration::from_secs(8));\n-        assert_eq!(backoff_delay(base, 10), Duration::from_secs(30), \"capped\");\n-        assert_eq!(backoff_delay(base, u32::MAX), Duration::from_secs(30));\n+        assert_jittered_around(backoff_delay(base, 0), Duration::from_secs(1));\n+        assert_jittered_around(backoff_delay(base, 1), Duration::from_secs(2));\n+        assert_jittered_around(backoff_delay(base, 3), Duration::from_secs(8));\n+        // Capped at MAX_BACKOFF, including when `2^attempt` saturates.\n+        assert_jittered_around(backoff_delay(base, 10), MAX_BACKOFF);\n+        assert_jittered_around(backoff_delay(base, u32::MAX), MAX_BACKOFF);\n     }\n \n     #[test]\n-    fn jitter_is_deterministic_and_bounded() {\n-        let a = jitter_fraction(\"shardId-000000000000\");\n-        let b = jitter_fraction(\"shardId-000000000001\");\n-        assert_eq!(a, jitter_fraction(\"shardId-000000000000\"));\n-        assert!((0.0..=0.25).contains(&a));\n-        assert!((0.0..=0.25).contains(&b));\n+    fn backoff_is_decorrelated_across_calls() {\n+        // Shards recovering from one shared throttle event must not re-fire in\n+        // lockstep — the fixed per-shard fraction this replaced always did\n+        // (#654 M13). Identical inputs must not yield an identical delay.\n+        let base = Duration::from_millis(1000);\n+        let delays: Vec<Duration> = (0..32).map(|_| backoff_delay(base, 2)).collect();\n+        assert!(\n+            delays.iter().any(|d| *d != delays[0]),\n+            \"every delay identical — jitter is not being applied: {delays:?}\"\n+        );\n     }\n \n     #[test]\ndiff --git a/crates/source/rest/src/decode.rs b/crates/source/rest/src/decode.rs\nindex 1ec04e28..de67e2e5 100644\n--- a/crates/source/rest/src/decode.rs\n+++ b/crates/source/rest/src/decode.rs\n@@ -280,6 +280,36 @@ fn records_from_value(v: Value, records_path: Option<&str>) -> Vec<Value> {\n     }\n }\n \n+/// One open element in the compact XML decoder: its object and its accumulated\n+/// text. The stack is seeded with a synthetic document-root frame.\n+type XmlFrame = (Map<String, Value>, String);\n+\n+/// Unbalanced-input error for the compact XML decoder.\n+///\n+/// The frame stack is seeded with one synthetic document-root frame, so\n+/// *balanced* input never empties it — but an unbalanced extra `</x>` pops the\n+/// root, and the frame access that follows used to `.expect()`, i.e. panic on\n+/// untrusted network input inside a live pipeline. `quick_xml`'s\n+/// `check_end_names` happens to reject the mismatch first, but that is a\n+/// dependency default, not an invariant this code owns (#654 L25) — so the\n+/// shortfall is reported as a typed error.\n+fn unbalanced_xml(detail: &str) -> FaucetError {\n+    FaucetError::Source(format!(\n+        \"decode `parse` xml: malformed XML: {detail}; the document has more closing \\\n+         than opening tags\"\n+    ))\n+}\n+\n+/// Borrow the innermost open frame, or report unbalanced input.\n+fn top_frame<'a>(stack: &'a mut [XmlFrame], detail: &str) -> Result<&'a mut XmlFrame, FaucetError> {\n+    stack.last_mut().ok_or_else(|| unbalanced_xml(detail))\n+}\n+\n+/// Pop the innermost open frame, or report unbalanced input.\n+fn pop_frame(stack: &mut Vec<XmlFrame>, detail: &str) -> Result<XmlFrame, FaucetError> {\n+    stack.pop().ok_or_else(|| unbalanced_xml(detail))\n+}\n+\n /// Compact XML → JSON: each element becomes an object of its children; repeated\n /// child tags become arrays; attributes are `@name`; text is `#text` (or the\n /// value directly when an element has only text).\n@@ -346,25 +376,26 @@ fn xml_to_json(bytes: &[u8]) -> Result<Value, FaucetError> {\n             Event::Empty(e) => {\n                 let name = local(e.name().as_ref());\n                 let val = finish(attrs(&e), String::new());\n-                let top = stack.last_mut(