    {
      "type": "timeseries",
      "title": "Connect flows (by provider & outcome, per hour)",
      "gridPos": {
        "x": 12,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, outcome) (increase(faucet_serve_connect_flows_total[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{provider}} {{outcome}}"
        }
