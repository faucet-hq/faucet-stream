            "uid": "${datasource}"
          },
          "legendFormat": "{{tenant}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Tenant limit rejections (by tenant & limit)",
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant, limit) (increase(faucet_serve_tenant_limit_rejections_total[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{tenant}} {{limit}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
