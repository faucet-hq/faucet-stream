          ]
        },
        "graphMode": "area"
      }
    },
    {
      "type": "timeseries",
      "title": "Template sync pulls (by origin & outcome, per hour)",
      "gridPos": {
        "x": 12,
        "y": 68,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (origin, outcome) (increase(faucet_serve_template_sync_runs_total[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{origin}} {{outcome}}"
