      "title": "Pending change requests",
      "gridPos": {
        "x": 9,
        "y": 68,
        "w": 3,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(faucet_serve_changes_pending)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "pending"
