  "sinks": [
    {
      "description": "Google BigQuery — one table per stream, atomic overwrite or keyed MERGE upsert",
      "docs": "https://faucet-hq.github.io/faucet-stream/reference/connectors.html",
      "file": "sink-templates/faucet-hq/bigquery.yaml",
      "id": "faucet-hq/bigquery",
      "name": "bigquery",
      "official": true,
      "owner": "faucet-hq",
      "params": [
        {
          "default": "raw",
          "description": "Dataset every stream's table lands in",
          "name": "bq_dataset",
          "required": false,
          "secret": false,
          "type": "string"
        },
        {
          "default": null,
          "description": "GCP project id that owns the dataset",
          "name": "bq_project",
          "required": true,
          "secret": false,
          "type": "string"
        },
        {
          "default": null,
          "description": "Service-account key JSON, inline. Pass it with --param-env from a secret store; copy this template and switch `auth` to application_default to use ADC instead.",
          "name": "bq_sa_key",
          "required": true,
          "secret": true,
          "type": "string"
        }
      ],
      "sink_type": "bigquery",
      "tags": [
        "warehouse",
        "gcp"
      ],
      "write_modes": [
        "append",
        "upsert",
        "delete",
        "overwrite"
      ]
    },
    {
      "description": "Local JSON Lines files, one per stream — the local validation destination",
      "docs": null,
      "file": "sink-templates/faucet-hq/jsonl.yaml",
      "id": "faucet-hq/jsonl",
      "name": "jsonl",
      "official": true,
      "owner": "faucet-hq",
      "params": [
        {
          "default": "./out",
          "description": "Directory to write <source>/<stream>.jsonl under",
          "name": "out_dir",
          "required": false,
          "secret": false,
          "type": "string"
        }
      ],
      "sink_type": "jsonl",
      "tags": [
        "file",
        "local"
      ],
      "write_modes": [
        "append"
      ]
    },
    {
      "description": "PostgreSQL — one auto-mapped table per stream, transactional overwrite or ON CONFLICT upsert",
      "docs": null,
      "file": "sink-templates/faucet-hq/postgres.yaml",
      "id": "faucet-hq/postgres",
      "name": "postgres",
      "official": true,
      "owner": "faucet-hq",
      "params": [
        {
          "default": "public",
          "description": "Schema every stream's table is created in",
          "name": "pg_schema",
          "required": false,
          "secret": false,
          "type": "string"
        },
        {
          "default": null,
          "description": "postgres://user:pass@host:5432/db connection URL",
          "name": "pg_url",
          "required": true,
          "secret": true,
          "type": "string"
        }
      ],
      "sink_type": "postgres",
      "tags": [
        "database"
      ],
      "write_modes": [
        "append",
        "upsert",
        "delete",
        "overwrite"
      ]
    },
    {
      "description": "Local SQLite database — one auto-mapped table per stream, real overwrite/upsert semantics without infrastructure",
      "docs": null,
      "file": "sink-templates/faucet-hq/sqlite.yaml",
      "id": "faucet-hq/sqlite",
      "name": "sqlite",
      "official": true,
      "owner": "faucet-hq",
      "params": [
        {
          "default": "./out/faucet.db",
          "description": "Database file (created if missing)",
          "name": "sqlite_path",
          "required": false,
          "secret": false,
          "type": "string"
        }
      ],
      "sink_type": "sqlite",
      "tags": [
        "database",
        "local"
      ],
      "write_modes": [
        "append",
        "upsert",
        "delete",
        "overwrite"
      ]
    }
  ],
  "sources": [
    {
      "description": "Example — two CSV exports as two streams (runs offline, no credentials)",
      "docs": null,
      "file": "source-templates/faucet-hq/example-csv.yaml",
      "id": "faucet-hq/example-csv",
      "name": "example-csv",
      "official": true,
      "owner": "faucet-hq",
      "params": [
        {
          "default": "./hub/examples/data",
          "description": "Directory holding orders.csv and customers.csv",
          "name": "data_dir",
          "required": false,
          "secret": false,
          "type": "string"
        }
      ],
      "source_type": "csv",
      "streams": [
        {
          "description": null,
          "name": "orders",
          "primary_keys": [
            "id"
          ],
          "write": [
            "overwrite",
            "upsert"
          ]
        },
        {
          "description": null,
          "name": "customers",
          "primary_keys": [
            "id"
          ],
          "write": [
            "overwrite",
            "upsert"
          ]
        }
      ],
      "tags": [
        "example",
        "file"
      ]
    },
    {
      "description": "Example — a bearer-authenticated REST API with cursor pagination and one stream per endpoint",
      "docs": null,
      "file": "source-templates/faucet-hq/example-rest-api.yaml",
      "id": "faucet-hq/example-rest-api",
      "name": "example-rest-api",
      "official": true,
      "owner": "faucet-hq",
      "params": [
        {
          "default": null,
          "description": "Bearer token",
          "name": "api_token",
          "required": true,
          "secret": true,
          "type": "string"
        },
        {
          "default": null,
          "description": "API root, e.g. https://api.example.com/v1",
          "name": "base_url",
          "required": true,
          "secret": false,
          "type": "string"
        }
      ],
      "source_type": "rest",
      "streams": [
        {
          "description": null,
          "name": "accounts",
          "primary_keys": [
            "id"
          ],
          "write": [
            "overwrite",
            "upsert"
          ]
        },
        {
          "description": null,
          "name": "events",
          "primary_keys": [
            "id"
          ],
          "write": [
            "upsert",
            "append"
          ]
        }
      ],
      "tags": [
        "example",
        "rest"
      ]
    }
  ],
  "version": 1
}
