<script>
  function buildFlows() {
    document.querySelectorAll<HTMLElement>('.fs-flow[data-flow]').forEach((el) => {
      if (el.dataset.fsFlowDone) return;
      const nodes = el.dataset.flow!.split('|').map((s) => s.trim()).filter(Boolean);
      if (!nodes.length) return;
      el.textContent = '';
      nodes.forEach((raw, i) => {
        const [name, sub] = raw.split('::').map((s) => (s || '').trim());
        const node = document.createElement('div');
        node.className = 'fs-flow-node';
        const nm = document.createElement('span');
        nm.className = 'fs-flow-name';
        nm.textContent = name;
        node.appendChild(nm);
        if (sub) {
          const s = document.createElement('span');
          s.className = 'fs-flow-sub';
          s.textContent = sub;
          node.appendChild(s);
        }
        el.appendChild(node);
        if (i < nodes.length - 1) {
          const edge = document.createElement('div');
          edge.className = 'fs-flow-edge';
          edge.setAttribute('aria-hidden', 'true');
          edge.innerHTML = '<i></i><i></i><i></i>';
          el.appendChild(edge);
        }
      });
      el.setAttribute('role', 'img');
      el.setAttribute('aria-label', nodes.map((n) => n.split('::')[0].trim()).join(' then '));
      el.dataset.fsFlowDone = '1';
    });
  }

  const MODE_KEY = 'faucet-learn-mode';
  function learnToggle(onReveal: (c: Element) => void) {
    const toggle = document.querySelector('[data-mode-toggle]');
    if (!toggle) return;
    const buttons = [...toggle.querySelectorAll<HTMLButtonElement>('.mode-switch button')];
    const contents = [...document.querySelectorAll('.mode-content')];
    if (!buttons.length || !contents.length) return;
    const revealed: Record<string, boolean> = {};
    const apply = (mode: string, user: boolean) => {
      buttons.forEach((b) => { const on = b.dataset.mode === mode; b.classList.toggle('active', on); b.setAttribute('aria-pressed', String(on)); });
      let active: Element | undefined;
      contents.forEach((c) => { const on = c.getAttribute('data-mode') === mode; c.classList.toggle('active', on); if (on) active = c; });
      if (user && active && !revealed[mode]) { revealed[mode] = true; onReveal(active); }
      // Starlight's TOC watches headings that were visible when it started; rebuild it for the new mode.
      if (user) { dispatchEvent(new Event('fs-layout')); dispatchEvent(new Event('resize')); }
      try { localStorage.setItem(MODE_KEY, mode); } catch {}
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.mode!, true)));
    // A TOC link (or a #hash) pointing into the hidden mode switches to it first, then scrolls there.
    const reveal = (hash: string) => {
      const target = hash ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
      const section = target?.closest('.mode-content');
      if (!target || !section || section.classList.contains('active')) return false;
      apply(section.getAttribute('data-mode')!, true);
      requestAnimationFrame(() => target.scrollIntoView());
      return true;
    };
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      if (a && reveal(a.hash)) { e.preventDefault(); history.pushState(null, '', a.hash); }
    });
    addEventListener('hashchange', () => reveal(location.hash));
    let saved: string | null = null;
    try { saved = localStorage.getItem(MODE_KEY); } catch {}
    const initial = saved === 'architect' ? 'architect' : 'beginner';
    revealed[initial] = true;
    apply(initial, false);
    reveal(location.hash);
  }

  type Mermaid = { initialize: (c: object) => void; run: (o: { nodes: HTMLElement[] }) => Promise<void> };
  let mermaidMod: Mermaid | null = null;
  const loadMermaid = () => new Promise<Mermaid>((resolve, reject) => {
    const w = window as unknown as { mermaid?: Mermaid };
    if (w.mermaid) return resolve(w.mermaid);
    const s = document.createElement('script');
    s.src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/mermaid.min.js`;
    s.onload = () => (w.mermaid ? resolve(w.mermaid) : reject(new Error('mermaid did not load')));
    s.onerror = () => reject(new Error('mermaid did not load'));
    document.head.appendChild(s);
  });
  const isDark = () => document.documentElement.dataset.theme !== 'light';
  function mermaidTheme(): object {
    const dark = isDark();
    return {
      startOnLoad: false,
      theme: 'base',
      fontFamily: 'Geist, system-ui, sans-serif',
      themeVariables: dark
        ? { primaryColor: '#132529', primaryTextColor: '#e7eef1', primaryBorderColor: '#2a6b66', lineColor: '#5eead4', secondaryColor: '#16232b', tertiaryColor: '#121d24', edgeLabelBackground: '#121d24', clusterBkg: '#121d24', clusterBorder: '#1f3a3e', titleColor: '#e7eef1', noteBkgColor: '#261f10', noteTextColor: '#fcd34d', noteBorderColor: '#4a3a17' }
        : { primaryColor: '#eef6f4', primaryTextColor: '#0f172a', primaryBorderColor: '#9ccfc5', lineColor: '#0f766e', secondaryColor: '#f3f2ed', tertiaryColor: '#ffffff', edgeLabelBackground: '#ffffff', clusterBkg: '#fbfaf7', clusterBorder: '#d9ebe6', titleColor: '#0f172a', noteBkgColor: '#fdf6ea', noteTextColor: '#78350f', noteBorderColor: '#f2dcb4' },
    };
  }
  async function renderMermaid(scope: ParentNode = document) {
    const nodes = [...scope.querySelectorAll<HTMLElement>('pre.mermaid')].filter((n) => n.offsetParent !== null);
    if (!nodes.length) return;
    if (!mermaidMod) { try { mermaidMod = await loadMermaid(); } catch (e) { console.warn(e); return; } }
    mermaidMod.initialize(mermaidTheme());
    nodes.forEach((n) => {
      if (!n.dataset.src) n.dataset.src = n.textContent || '';
      n.removeAttribute('data-processed');
      n.textContent = n.dataset.src;
    });
    try { await mermaidMod.run({ nodes }); } catch (e) { console.warn('mermaid', e); }
  }

  function catalogFilter() {
    const box = document.querySelector<HTMLElement>('[data-fs-catalog]');
    if (!box) return;
    const tableAfter = (id: string) => {
      const h = document.getElementById(id);
      let el: Element | null = h ? (h.closest('.sl-heading-wrapper') ?? h) : null;
      const owned: Element[] = el ? [el] : [];
      while (el && (el = el.nextElementSibling)) { owned.push(el); if (el.tagName === 'TABLE' || el.querySelector('table')) break; }
      const table = owned.length ? (owned[owned.length - 1].tagName === 'TABLE' ? owned[owned.length - 1] : owned[owned.length - 1].querySelector('table')) : null;
      return { owned, rows: table ? [...table.querySelectorAll<HTMLTableRowElement>('tbody tr')] : [] };
    };
    const kinds = { Sources: tableAfter('sources'), Sinks: tableAfter('sinks') };
    const total = kinds.Sources.rows.length + kinds.Sinks.rows.length;
    if (!total) return;
    box.innerHTML = `<label class="fs-filter-input"><svg class="fs-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4.2-4.2"/></svg><input type="search" placeholder="Filter connectors…" aria-label="Filter connectors"></label>
      <button type="button" class="fs-chip" data-kind="All" aria-pressed="true">All<span class="ct">${total}</span></button>
      <button type="button" class="fs-chip" data-kind="Sources" aria-pressed="false">Sources<span class="ct">${kinds.Sources.rows.length}</span></button>
      <button type="button" class="fs-chip" data-kind="Sinks" aria-pressed="false">Sinks<span class="ct">${kinds.Sinks.rows.length}</span></button>
      <button type="button" class="fs-chip" data-t1 aria-pressed="false">T1 only</button>
      <p class="fs-filter-count" aria-live="polite"></p>`;
    const empty = document.createElement('div');
    empty.className = 'fs-filter-empty fs-hidden not-content';
    box.after(empty);
    const input = box.querySelector('input')!;
    const count = box.querySelector('.fs-filter-count')!;
    let kind = 'All', t1 = false;
    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      (Object.entries(kinds) as [string, { owned: Element[]; rows: HTMLTableRowElement[] }][]).forEach(([k, part]) => {
        const kindOn = kind === 'All' || kind === k;
        let partShown = 0;
        part.rows.forEach((r) => {
          const cells = r.cells;
          const text = ((cells[0]?.textContent ?? '') + ' ' + (cells[2]?.textContent ?? '')).toLowerCase();
          const ok = kindOn && (!q || text.includes(q)) && (!t1 || (cells[1]?.textContent ?? '').includes('T1'));
          r.classList.toggle('fs-hidden', !ok);
          if (ok) partShown++;
        });
        part.owned.forEach((el) => el.classList.toggle('fs-hidden', partShown === 0));
        shown += partShown;
      });
      const filtered = q || kind !== 'All' || t1;
      count.textContent = filtered ? `Showing ${shown} of ${total}${q ? ` matching “${input.value.trim()}”` : ''}` : `${total} connectors`;
      empty.classList.toggle('fs-hidden', shown > 0);
      empty.innerHTML = `<b>No connector matches “${input.value.trim().replace(/[<>&]/g, '')}”</b>Try a shorter name, or look for community crates on the Connector Hub.`;
    };
    box.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((b) => b.addEventListener('click', () => {
      kind = b.dataset.kind!;
      box.querySelectorAll('[data-kind]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
    const t1b = box.querySelector<HTMLButtonElement>('[data-t1]')!;
    t1b.addEventListener('click', () => { t1 = !t1; t1b.setAttribute('aria-pressed', String(t1)); apply(); });
    input.addEventListener('input', apply);
    apply();
  }

  function longCode() {
    document.querySelectorAll<HTMLElement>('.sl-markdown-content :not(pre) > code').forEach((c) => {
      if ((c.textContent || '').length > 40) c.classList.add('fs-long');
    });
  }

  // The last sections of a page are often too short for their heading to reach the top of the
  // window, so the TOC can never mark them current. Give the page just enough room below.
  function tocTailRoom() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('starlight-toc nav a[href^="#"]')];
    const last = links.length > 1 ? document.getElementById(decodeURIComponent(links[links.length - 1].hash.slice(1))) : null;
    const main = document.querySelector<HTMLElement>('.main-pane');
    if (!last || !main) return;
    const apply = () => {
      main.style.paddingBottom = '';
      const nav = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--sl-nav-height')) * 16 || 64;
      const top = last.getBoundingClientRect().top + scrollY;
      const room = document.documentElement.scrollHeight - top;
      const need = innerHeight - nav - 32 - room;
      if (need > 0) main.style.paddingBottom = `${Math.ceil(need)}px`;
    };
    apply();
    addEventListener('resize', apply, { passive: true });
    addEventListener('load', apply, { once: true });
    addEventListener('fs-layout', apply);
  }

  // Clicking a TOC item marks it current once the page has scrolled to its heading; Starlight's own
  // tracking can miss a heading that lands just above its detection band (short or revealed sections).
  function tocClickSelects() {
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('starlight-toc a[href^="#"], mobile-starlight-toc a[href^="#"]');
      if (!a) return;
      const hash = a.hash;
      setTimeout(() => {
        const target = document.getElementById(decodeURIComponent(hash.slice(1)));
        if (!target) return;
        const top = target.getBoundingClientRect().top;
        if (top < -4 || top > innerHeight * 0.5) return;
        document.querySelectorAll<HTMLElement & { current?: HTMLAnchorElement }>('starlight-toc, mobile-starlight-toc').forEach((toc) => {
          const link = [...toc.querySelectorAll<HTMLAnchorElement>('a')].find((l) => l.hash === hash);
          if (link) toc.current = link;
        });
      }, 700);
    });
  }

  // Keep the highlighted TOC item in view when the list is longer than the window.
  function tocFollow() {
    const pane = document.querySelector<HTMLElement>('.right-sidebar');
    const toc = document.querySelector('starlight-toc');
    if (!pane || !toc) return;
    new MutationObserver(() => {
      const cur = toc.querySelector<HTMLElement>('a[aria-current="true"]');
      if (!cur) return;
      const p = pane.getBoundingClientRect(), c = cur.getBoundingClientRect();
      if (c.top < p.top + 48 || c.bottom > p.bottom - 24) pane.scrollTo({ top: pane.scrollTop + (c.top - p.top) - p.height / 3, behavior: 'smooth' });
    }).observe(toc, { subtree: true, attributes: true, attributeFilter: ['aria-current'] });
  }

  // Size each table by its content: the column with the most text gets a readable width, short
  // columns never wrap. Avoids squashed tables without guessing which column is the prose.
  function tables() {
    document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table').forEach((t) => {
      const rows = [...t.rows];
      const cols = Math.max(...rows.map((r) => r.cells.length));
      const len = (c?: HTMLTableCellElement) => (c?.textContent || '').trim().length;
      const avg: number[] = [], max: number[] = [];
      for (let i = 0; i < cols; i++) {
        const body = rows.slice(1).map((r) => len(r.cells[i]));
        avg[i] = body.reduce((a, b) => a + b, 0) / Math.max(body.length, 1);
        max[i] = Math.max(0, ...rows.map((r) => len(r.cells[i])));
      }
      const prose = avg.indexOf(Math.max(...avg));
      if (cols >= 6) t.classList.add('fs-wide');
      rows.forEach((r) => [...r.cells].forEach((c, i) => {
        if (i === prose && avg[i] > 45) c.classList.add('fs-prose');
        else if (max[i] <= 28) c.classList.add('fs-short');
        else if (c.tagName === 'TD') c.classList.add('fs-mid');
      }));
      if (!t.parentElement?.classList.contains('fs-table')) {
        const box = document.createElement('div');
        box.className = 'fs-table';
        t.replaceWith(box);
        box.appendChild(t);
      }
    });
  }

  function init() {
    buildFlows();
    tables();
    longCode();
    tocTailRoom();
    tocFollow();
    tocClickSelects();
    catalogFilter();
    learnToggle((c) => renderMermaid(c));
    if (document.querySelector('pre.mermaid')) {
      renderMermaid();
      new MutationObserver(() => renderMermaid()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
</script>
